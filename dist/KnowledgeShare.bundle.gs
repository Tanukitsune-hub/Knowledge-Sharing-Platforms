    mapped.warnings.length === 0 &&
    mapped.citations[0].sourceType === KSP_AI_SOURCE_TYPES.PITCHBOOK &&
    mapped.citations[0].sourceId === 'DOC-000017';
  var diagnostic = {
    classification: 'PASS', transport: transport, modelId: profile.modelId,
