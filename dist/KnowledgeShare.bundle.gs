    var definition = kspGetKnowledgeModeDefinition_(mode);
    definition.gpRequired = definition.targetRequired;
    return definition;
  } catch (error) {
    error.code = 'KNOWLEDGE_EXPORT_MODE_INVALID';
    throw error;
  }
}

function kspGetKnowledgeExportModeDefinitions_() {
