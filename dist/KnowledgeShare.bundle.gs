        defaultThinking.enabled && defaultThinking.qualification === KSP_AI_MODEL_QUALIFICATION_STATES.QUALIFIED &&
        profile.apiAccess === KSP_AI_MODEL_ACCESS_STATES.AVAILABLE &&
