  return /^PROVIDER_TERMINAL_(FAILED|CANCELLED|REQUIRES_ACTION|INCOMPLETE|BUDGET_EXCEEDED)$/.test(classification)
    ? classification : 'RESPONSE_SHAPE_OR_APPLICATION_FAILURE';
