  }
  if (dateFrom && dateTo) {
    kspAssert_(dateFrom <= dateTo, 'RELATIONSHIP_EXPLORER_DATE_RANGE_INVALID',
      'Relationship Explorerの日付範囲が不正です。');
  }
  return {
    dateFrom: dateFrom,
    dateTo: dateTo,
    filters: {
      counterpartyType: kspRelationshipFilterValue_(supplied.counterpartyType),
