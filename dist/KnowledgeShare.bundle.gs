var KSP_MEETING_WORK_ID = '0005';
var KSP_MEETING_APP_VERSION = '0.2.0';
var KSP_MEETING_DRAFT_TTL_MS = 24 * 60 * 60 * 1000;

var KSP_OPTION_TYPES = Object.freeze({
