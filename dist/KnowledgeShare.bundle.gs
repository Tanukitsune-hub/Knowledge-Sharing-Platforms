    return kspOpenAiCreateVectorStoreLive_(displayName);
  };
  base.getOpenAiVectorStore = function (vectorStoreId) {
    return kspOpenAiGetVectorStoreLive_(vectorStoreId);
  };
  base.writeAiSetting = function (key, value, nowIso) {
