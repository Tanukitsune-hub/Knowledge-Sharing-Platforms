}

function kspGeminiE2eCandidateResult_(profile) {
  return {
    modelId: profile.modelId,
    profile: profile,
    attempted: true,
    modelVisible: false,
    shortInteractions: { result: 'NOT_RUN', diagnostic: null },
    fileSearchQuery: { result: 'NOT_RUN', diagnostic: null },
