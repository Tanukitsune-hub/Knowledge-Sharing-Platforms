  if (provider === KSP_AI_PROVIDERS.GEMINI && (!config.modelId || config.credentialConfigured === false)) {
    var gemini = new Error('GEMINI provider is not configured.');
    gemini.code = 'GEMINI_NOT_CONFIGURED';
