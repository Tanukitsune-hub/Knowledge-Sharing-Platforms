/div>\n      <div class=\"attachment-workspace\"><div class=\"attachment-drop-column\"><div id=\"pitchbook-drop-zone\" class=\"drop-zone\" tabindex=\"0\" role=\"button\" aria-label=\"添付資料を選択\">ファイルをドロップ、またはクリックして選択<br><span id=\"pitchbook-file-formats\" class=\"hint\">対応形式を読み込み中…</span></div>\n      <input id=\"pitchbook-files\" class=\"hidden-input\" type=\"file\" multiple accept=\".pdf,.pptx,.xlsx,.docx,.txt,.eml\"></div></div>\n      <div id=\"pitchbook-file-summary\" class=\"summary\"></div><div id=\"pitchbook-file-list\" class=\"file-list\"></div>\n    </section>\n    <div id=\"meeting-file-actions\" class=\"attachment-action-column\"><button id=\"pitchbook-clear\" class=\"action secondary\" type=\"button\">資料選択をクリア</button><button id=\"pitchbook-retry\" class=\"action warning ksp-keep-focus-busy\" type=\"button\" disabled>未完了分を再試行</button><button id=\"pitchbook-submit\" class=\"action primary ksp-keep-focus-busy\" type=\"button\" hidden disabled>この記録へ資料を追加</button></div>\n\n    <?!= include_('MaintenancePages'); ?>\n    <?!= include_('EntityWorkspacePage'); ?>\n    <?!= include_('ActivityAnalyticsPage'); ?>\n    <?!= include_('RelationshipExplorerPage'); ?>\n    <?!= include_('KnowledgeSearchPage'); ?>\n    <?!= include_('AiProviderSettingsPage'); ?>\n    <div id=\"entity-workspace-print\" class=\"entity-workspace-print print-only\" aria-hidden=\"true\"></div>\n  </main>\n\n  <div id=\"counterparty-modal-backdrop\" class=\"modal-backdrop\" hidden>\n    <section id=\"counterparty-modal\" class=\"counterparty-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"counterparty-modal-title\" aria-describedby=\"counterparty-modal-help\" tabindex=\"-1\">\n      <div class=\"counterparty-modal-heading\">\n        <div><p class=\"counterparty-modal-kicker\">面談先マスター</p><h2 id=\"counterparty-modal-title\">新規面談先を追加</h2></div>\n        <button id=\"counterparty-modal-close\" class=\"modal-close\" type=\"button\" aria-label=\"閉じる\">×</button>\n      </div>\n      <p