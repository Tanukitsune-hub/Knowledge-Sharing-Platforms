  "ClientKnowledgeSearch": "<script>\nconst KSP_QUERY_AUTO_POLL_LIMIT=12;\nconst KSP_QUERY_STORAGE_KEY='ksp.knowledge.query.v1';\nconst KSP_KNOWLEDGE_SOURCE_CONTROLS=[['Meeting','knowledge-source-meeting'],['Pitchbook','knowledge-source-pitchbook'],['News','knowledge-source-news'],['Internal Assessment','knowledge-source-assessment']];\nconst knowledgeState={freeQuestionDraft:'',appliedMode:'自由質問',savedPeriod:null,loading:true,configured:false,modeDefinitions:{},modelPolicies:{},options:{},exportPreview:null,exportBusy:false,exportRequestId:0,exportActionButton:null,pendingQueryToken:'',pendingQueryRoute:'OPENAI',pendingQueryFingerprint:'',pendingQueryStartedAt:0,pendingQueryPollCount:0,pendingQueryPolling:false,pendingQueryAutoStopped:false,pendingQueryTimer:null,startingQuery:false,queryRequestSequence:0};\nfunction kEl(id){return document.getElementById(id)}\nfunction kSafeKnowledgeDriveUrl(value){const candidate=String(value==null?'':value).trim();const docs=/^https:\\/\\/docs\\.google\\.com\\/document\\/d\\/[^/?#&]+(?:[/?#]|$)/i;const file=/^https:\\/\\/drive\\.google\\.com\\/file\\/d\\/[^/?#&]+(?:[/?#]|$)/i;const open=/^https:\\/\\/drive\\.google\\.com\\/(?:open|uc)\\?[^#]*\\bid=[^&#]+/i;return docs.test(candidate)||file.test(candidate)||open.test(candidate)?candidate:''}\nfunction kShowStatus(kind,message){const box=kEl('knowledge-status');box.className='status visible '+kind;box.textContent=message;if(kind==='error')kEl('knowledge-result').classList.add('hidden-panel')}\nfunction kClearStatus(){const box=kEl('knowledge-status');box.className='status';box.textContent=''}\nfunction kShowExportStatus(kind,message){const box=kEl('knowledge-export-status');box.className='status visible '+kind;box.textContent=message}\nfunction kClearExportStatus(){const box=kEl('knowledge-export-status');box.className='status';box.textContent=''}\nfunction kServerCall(name,payload){return new Promise((resolve,reject)=>{const runner=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);runner[name](payload)})}\nfunction kAddOptions(id,options){const select=kEl(id);select.innerHTML='<option value=\"\">未選択</option>';(options||[]).forEach(option=>{const node=document.createElement('option');node.value=option.id;node.textContent=option.name+(option.status==='Inactive'?'（Inactive）':'');select.appendChild(node)})}\nfunction kRefreshEntityOptions(){const type=kEl('knowledge-counterpartyType').value;const selected=kEl('knowledge-entityKey').value;kAddOptions('knowledge-entityKey',(knowledgeState.options.counterpartyEntities||[]).filter(item=>!type||item.type===type));if([...kEl('knowledge-entityKey').options].some(option=>option.value===selected))kEl('knowledge-entityKey').value=selected}\nfunction kRefreshMultiEntityOptions(){const select=kEl('knowledge-entityKeys');const selected=new Set([...select.selectedOptions].map(option=>option.value));select.innerHTML='';(knowledgeState.options.counterpartyEntities||[]).forEach(item=>{const option=document.createElement('option');option.value=item.entityKey||item.id;option.textContent=(item.type||'Entity')+' / '+item.name+(item.status==='Inactive'?'（Inactive）':'');option.selected=selected.has(option.value);select.appendChild(option)})}\nfunction kSelectedEntityKeys(){return[...kEl('knowledge-entityKeys').selectedOptions].map(option=>option.value)}\nfunction kSelectedSourceTypes(){return KSP_KNOWLEDGE_SOURCE_CONTROLS.filter(item=>kEl(item[1]).checked).map(item=>item[0])}\nfunction kSourceTypeLabel(sourceType){const catalog=knowledgeState.options.sourceTypes||[];const item=catalog.find(option=>option.id===sourceType);return item&&item.name||String(sourceType||'')}\nfunction kSelectedSourceScopeText(){const types=kSelectedSourceTypes();return '情報ソース: '+(types.length?types.map(kSourceTypeLabel).join('・'):'未選択')}\nfunction kSourceSelectionIssue(filters){const types=filters.sourceTypes||[];if(!types.length)return '情報ソースを1つ以上選択してください。';if((filters.teamId||filters.followUp||filters.meetingTypeCod