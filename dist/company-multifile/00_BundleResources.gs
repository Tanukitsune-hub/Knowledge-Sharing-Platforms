umber(item.citationCount||0)+'件':'証拠不足');row.append(label,state);box.appendChild(row)})}\nfunction kClearPendingQuery(){if(knowledgeState.pendingQueryTimer){clearTimeout(knowledgeState.pendingQueryTimer);knowledgeState.pendingQueryTimer=null}knowledgeState.pendingQueryToken='';knowledgeState.pendingQueryRoute='OPENAI';knowledgeState.pendingQueryFingerprint='';knowledgeState.pendingQueryStartedAt=0;knowledgeState.pendingQueryPollCount=0;knowledgeState.pendingQueryPolling=false;knowledgeState.pendingQueryAutoStopped=false;try{if(typeof sessionStorage!=='undefined')sessionStorage.removeItem(KSP_QUERY_STORAGE_KEY)}catch(error){}const recheck=kEl('knowledge-recheck');if(recheck)recheck.hidden=true;kSetBusy(false)}\nfunction kPersistPendingQuery(){if(!knowledgeState.pendingQueryToken)return;try{if(typeof sessionStorage!=='undefined')sessionStorage.setItem(KSP_QUERY_STORAGE_KEY,JSON.stringify({queryToken:knowledgeState.pendingQueryToken,route:knowledgeState.pendingQueryRoute,fingerprint:knowledgeState.pendingQueryFingerprint,startedAt:knowledgeState.pendingQueryStartedAt,pollCount:knowledgeState.pendingQueryPollCount,autoStopped:knowledgeState.pendingQueryAutoStopped}))}catch(error){}}\nfunction kLoadPendingQuery(){try{if(typeof sessionStorage==='undefined')return;const raw=sessionStorage.getItem(KSP_QUERY_STORAGE_KEY);if(!raw)return;const saved=JSON.parse(raw);if(!saved||typeof saved.queryToken!=='string'||!saved.queryToken.trim()||saved.queryToken.length>128){sessionStorage.removeItem(KSP_QUERY_STORAGE_KEY);return}knowledgeState.pendingQueryToken=saved.queryToken.trim();knowledgeState.pendingQueryRoute=saved.route==='GEMINI'?'GEMINI':'OPENAI';knowledgeState.pendingQueryFingerprint=typeof saved.fingerprint==='string'?saved.fingerprint:'';knowledgeState.pendingQueryStartedAt=Number(saved.startedAt)||Date.now();knowledgeState.pendingQueryPollCount=Number(saved.pollCount)||0;knowledgeState.pendingQueryAutoStopped=Boolean(saved.autoStopped)}catch(error){try{sessionStorage.removeItem(KSP_QUERY_STORAGE_KEY)}catch(ignored){}}}\nfunction kKnowledgeQueryFingerprint(payload){const value=payload||{};const identity=JSON.stringify({route:value.route||'',modelProfileId:value.modelProfileId||'',thinkingProfileId:value.thinkingProfileId||'',mode:value.mode||'',questionOrInstruction:value.questionOrInstruction||'',filters:value.filters||{},selectedEntityKeys:value.selectedEntityKeys||[]});let hash=0xcbf29ce484222325n;for(let i=0;i<identity.length;i++)hash=((hash^BigInt(identity.charCodeAt(i)))*0x100000001b3n)&0xffffffffffffffffn;return identity.length.toString(16)+':'+hash.toString(16).padStart(16,'0')}\nfunction kKnowledgeRequestIsCurrent(requestId,fingerprint){return requestId===knowledgeState.queryRequestSequence&&fingerprint===kKnowledgeQueryFingerprint(kPayload())}\nfunction kKnowledgePendingElapsed(){return knowledgeState.pendingQueryStartedAt?Math.max(0,Date.now()-knowledgeState.pendingQueryStartedAt):0}\nfunction kShowPendingStatus(result){const elapsed=Math.floor(kKnowledgePendingElapsed()/1000);const long=Boolean(result&&result.longRunning)||knowledgeState.pendingQueryAutoStopped||elapsed>=60;kShowStatus((long?'warning':'info')+' busy',kSelectedSourceScopeText()+' / 検索を処理中です。経過 '+elapsed+'秒'+(long?'（時間がかかっていますが、失敗ではありません）':'。結果を確認しています。'));const recheck=kEl('knowledge-recheck');if(recheck)recheck.hidden=false}\nfunction kClearPendingQueryForTerminal(){if(knowledgeState.pendingQueryTimer){clearTimeout(knowledgeState.pendingQueryTimer);knowledgeState.pendingQueryTimer=null}knowledgeState.pendingQueryToken='';knowledgeState.pendingQueryRoute='OPENAI';knowledgeState.pendingQueryFingerprint='';knowledgeState.pendingQueryStartedAt=0;knowledgeState.pendingQueryPollCount=0;knowledgeState.pendingQueryAutoStopped=false;try{if(typeof sessionStorage!=='undefined')sessionStorage.removeItem(KSP_QUERY_STORAGE_KEY)}catch(error){}const recheck=kEl('knowledge-recheck');if(recheck)recheck.hidden=true}\nfunction kRenderResult(result){kClearPendingQueryForTerm