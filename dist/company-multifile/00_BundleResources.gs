  "ClientActivityAnalytics": "<script>\nlet activityAnalyticsData=null,activityAnalyticsRequestSequence=0,activityAnalyticsLoaded=false,activityActiveView='graph',activityAdminCheckBusy=false;\nconst ACTIVITY_ANALYTICS_FILTERS=[\n  ['counterpartyEntities','activity-filter-counterpartyEntity'],\n  ['assetClasses','activity-filter-assetClass'],\n  ['teams','activity-filter-team'],\n  ['meetingTypes','activity-filter-meetingType'],\n  ['statuses','activity-filter-status']\n];\nfunction activityDisplay(value){return String(value||'')==='__UNSET__'?'未設定':String(value==null?'':value)}\nfunction activityPeriodLabel(value){return ({monthly:'月次',quarter:'四半期',calendarYear:'暦年',fiscalYear:'会計年度',custom:'日次',cumulative:'累積'})[value]||'期間'}\nfunction activitySelectOptions(id,items){const node=el(id);if(!node)return;const current=node.value;node.innerHTML='<option value=\"\">未選択</option>';(items||[]).forEach(item=>{const option=document.createElement('option');option.value=String(item.value||'');option.textContent=activityDisplay(item.label||item.value);node.appendChild(option)});if([...node.options].some(option=>option.value===current))node.value=current}\nfunction activityPayload(){return{period:el('activity-period').value,dateFrom:el('activity-date-from').value,dateTo:el('activity-date-to').value,dimension:el('activity-dimension').value,filters:{counterpartyType:'',counterpartyEntity:el('activity-filter-counterpartyEntity').value,assetClass:el('activity-filter-assetClass').value,team:el('activity-filter-team').value,meetingType:el('activity-filter-meetingType').value,status:el('activity-filter-status').value}}}\nfunction activityFilterOptions(data){ACTIVITY_ANALYTICS_FILTERS.forEach(([key,id])=>activitySelectOptions(id,data&&data.filterOptions?data.filterOptions[key]:[]))}\nfunction activityMetricCards(metrics){const source=metrics||{};return[['面談件数',source.meetingCount||0],['有効な面談記録',source.activeMeetingCount||0],['面談先',source.distinctCounterpartyCount||0]].map(([label,value])=>'<div class=\"analytics-stat\"><strong>'+kspEscapeHtml(value)+'</strong><span>'+label+'</span></div>').join('')}\nfunction activityChart(items,field,label){const values=(items||[]).map(item=>Number(item[field]||0));if(!values.length)return'<p class=\"hint\">該当するデータがありません。</p>';const max=Math.max(...values,1),width=Math.max(560,values.length*86),chartHeight=150,barWidth=Math.max(18,Math.min(58,Math.floor(width/Math.max(values.length*1.7,1))));return'<svg class=\"analytics-svg\" viewBox=\"0 0 '+width+' 190\" role=\"img\" aria-label=\"'+kspEscapeHtml(label)+'\"><line class=\"analytics-axis\" x1=\"30\" y1=\"'+(chartHeight+10)+'\" x2=\"'+(width-12)+'\" y2=\"'+(chartHeight+10)+'\"></line>'+items.map((item,index)=>{const value=Number(item[field]||0),height=value/max*chartHeight,x=38+index*(width-54)/Math.max(items.length,1),y=chartHeight+10-height;return'<rect class=\"analytics-bar\" x=\"'+x+'\" y=\"'+y+'\" width=\"'+barWidth+'\" height=\"'+height+'\" rx=\"3\"><title>'+kspEscapeHtml(item.label)+': '+value+'</title></rect><text class=\"analytics-label\" x=\"'+(x+barWidth/2)+'\" y=\"'+Math.max(12,y-4)+'\" text-anchor=\"middle\">'+value+'</text><text class=\"analytics-label\" x=\"'+(x+barWidth/2)+'\" y=\"180\" text-anchor=\"middle\" transform=\"rotate(-35 '+(x+barWidth/2)+' 180)\">'+kspEscapeHtml(item.label)+'</text>'}).join('')+'</svg>'}\nfunction activityRenderSeries(series){const rows=(series||[]).map(item=>'<tr><td>'+kspEscapeHtml(item.label)+'</td><td>'+kspEscapeHtml(item.meetingCount)+'</td><td>'+kspEscapeHtml(item.activeMeetingCount)+'</td><td>'+kspEscapeHtml(item.distinctCounterpartyCount)+'</td></tr>').join('');el('activity-series-results').innerHTML=rows||'<tr><td colspan=\"4\" class=\"empty-cell\">該当なし</td></tr>';el('activity-series-chart').innerHTML=activityChart(series,'meetingCount','面談件数の期間推移')}\nfunction activityRenderBreakdown(breakdown){const items=breakdown&&breakdown.items||[];const rows=items.map(item=>'<tr><td>'+kspEscapeHtml(item.label)+'</td><td>'+kspEscapeHtml(item.meetingCount)+'</td><td>'+kspEscapeHtml(item.activeMeetingCount)+'</td><td>'+kspEscapeHtml(item.distinctCounterpartyCount)+'</td></tr>').join('');el('activity-breakdown-results').innerHTML=rows||'<tr><td colspan=\"4\" class=\"empty-cell\">該当なし</td></tr>';el('activity-breakdown-chart').innerHTML=activityChart(items,'meetingCount','選択した内訳別の面談件数');const omitted=Number(breakdown&&breakdown.omittedCount||0);el('activity-breakdown-summary').textContent=(breakdown&&breakdown.totalCount||0)+'区分'+(omitted?'（'+omitted+'区分は省略）':'')}\nfunction activityRenderDrill(records,omitted){const rows=(records||[]).map(record=>{const link=record.documentUrl?'<a class=\"small-link\" href=\"'+kspEscapeHtml(kspSafeDriveUrl(record.documentUrl))+'\" target=\"_blank\" rel=\"noopener\">原本</a>':'';const labels=(record.meetingTypeLabels||[]).join(' / ')||'未設定';const checkbox='<input class=\"activity-admin-check-input\" type=\"checkbox\" data-activity-admin-meeting=\"'+kspEscapeHtml(record.meetingId)+'\" aria-label=\"'+kspEscapeHtml(record.meetingId)+' 確認済み\"'+(record.adminCheckCompleted?' checked':'')+'>';return'<tr><td>'+kspEscapeHtml(record.date)+(record.time?'<br><span class=\"hint\">'+kspEscapeHtml(record.time)+'</span>':'')+'</td><td>'+kspEscapeHtml(record.meetingId)+'</td><td>'+kspEscapeHtml(record.counterpartyName||'未設定')+'</td><td>'+kspEscapeHtml(record.teamName||'未設定')+'</td><td>'+kspEscapeHtml(labels)+'</td><td><span class=\"badge '+kspEscapeHtml(record.status)+'\">'+kspEscapeHtml(record.status||'未設定')+'</span></td><td>'+link+'</td><td class=\"activity-admin-check-cell\">'+checkbox+'</td></tr>'}).join('');el('activity-drill-results').innerHTML=rows||'<tr><td colspan=\"8\" class=\"empty-cell\">該当なし</td></tr>';el('activity-drill-summary').textContent=(records||[]).length+'件を表示'+(omitted?'（'+omitted+'件は省略）':'')}\nfunction selectActivityView(view,focus){const next=view==='list'?'list':'graph';activityActiveView=next;document.querySelectorAll('[data-activity-view]').forEach(button=>{const selected=button.dataset.activityView===next;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected));button.tabIndex=selected?0:-1;if(selected&&focus)button.focus()});el('activity-graph-panel').hidden=next!=='graph';el('activity-list-panel').hidden=next!=='list'}\nfunction activityRender(data){activityAnalyticsData=data;activityFilterOptions(data);const period=data.period||{};el('activity-period-summary').textContent=activityPeriodLabel(period.mode)+' / '+(period.startDate||'')+' - '+(period.endDate||'')+' / '+(period.bucketCount||0)+'期間';el('activity-headline').innerHTML=activityMetricCards(data.headline);activityRenderSeries(data.series||[]);activityRenderBreakdown(data.breakdown||{});activityRenderDrill(data.drill&&data.drill.records||[],data.drill&&data.drill.omittedCount||0)}\nfunction activityRestoreAdminFocus(meetingId){const replacement=[...el('activity-drill-results').querySelectorAll('[data-activity-admin-meeting]')].find(node=>node.dataset.activityAdminMeeting===meetingId);(replacement||el('activity-analytics-refresh')).focus({preventScroll:true})}\nasync function loadActivityAnalytics(trigger){const requestId=++activityAnalyticsRequestSequence;kspSetActionBusy(trigger,true,'集計中…');kspSetRegionBusy(el('page-activity-analytics'),true);showStatus('activity-analytics-status','info busy','集計中…');try{const result=await serverCall('getMeetingActivityAnalytics',activityPayload());if(requestId!==activityAnalyticsRequestSequence)return;if(!result||!result.ok)throw new Error(result&&result.error?result.error.message:'面談実績を集計できませんでした。');activityAnalyticsLoaded=true;activityRender(result);showStatus('activity-analytics-status','success','集計しました。')}catch(error){if(requestId===activityAnalyticsRequestSequence)showStatus('activity-analytics-status','error',error.message||String(error))}finally{kspSetActionBusy(trigger,false);if(requestId===activityAnalyticsRequestSequence)kspSetRegionBusy(el('page-activity-analytics'),false)}}\nasync function updateActivityAdminCheck(checkbox){if(activityAdminCheckBusy)return;const records=activityAnalyticsData&&activityAnalyticsData.drill&&activityAnalyticsData.drill.records;if(!Array.isArray(records))return;const meetingId=checkbox.dataset.activityAdminMeeting;const record=records.find(item=>item.meetingId===meetingId);if(!record){checkbox.checked=!checkbox.checked;await loadActivityAnalytics();activityRestoreAdminFocus(meetingId);showStatus('activity-admin-check-status','error','対象の面談記録を読み直しました。');return}const expectedCompleted=Boolean(record.adminCheckCompleted),expectedUpdatedAt=record.adminCheckUpdatedAt||'',desiredCompleted=Boolean(checkbox.checked),retainFocus=document.activeElement===checkbox;activityAdminCheckBusy=true;document.querySelectorAll('[data-activity-admin-meeting]').forEach(node=>{node.disabled=true});checkbox.setAttribute('aria-busy','true');kspSetRegionBusy(el('activity-list-panel'),true);showStatus('activity-admin-check-status','info busy','月次管理状態を更新中…');try{const result=await serverCall('updateMeetingAdminCheck',{meetingId:record.meetingId,desiredCompleted:desiredCompleted,expectedAdminCheckCompleted:expectedCompleted,expectedAdminCheckUpdatedAt:expectedUpdatedAt});if(!result||!result.ok)throw new Error(result&&result.error?result.error.message:'月次管理状態の更新に失敗しました。');if(!result.adminCheck)throw new Error('月次管理状態の更新結果を読み込めません。');record.adminCheckCompleted=Boolean(result.adminCheck.completed);record.adminCheckUpdatedAt=result.adminCheck.updatedAt||'';record.adminCheckUpdatedBy=result.adminCheck.updatedBy||'';checkbox.checked=record.adminCheckCompleted;showStatus('activity-admin-check-status','success',result.changed?'月次管理状態を更新しました。':'状態は既に同じです。')}catch(error){checkbox.checked=expectedCompleted;await loadActivityAnalytics();activityRestoreAdminFocus(meetingId);showStatus('activity-admin-check-status','error',error.message||String(error))}finally{activityAdminCheckBusy=false;checkbox.setAttribute('aria-busy','false');kspSetRegionBusy(el('activity-list-panel'),false);document.querySelectorAll('[data-activity-admin-meeting]').forEach(node=>{node.disabled=false});if(retainFocus&&checkbox.isConnected)checkbox.focus({preventScroll:true})}}\ndocument.querySelectorAll('[data-activity-view]').forEach(button=>{button.addEventListener('click',()=>selectActivityView(button.dataset.activityView));button.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?'graph':event.key==='End'?'list':activityActiveView==='graph'?'list':'graph';selectActivityView(next,true)})});\nel('activity-analytics-refresh').onclick=event=>loadActivityAnalytics(event.currentTarget);el('activity-drill-results').addEventListener('change',event=>{const checkbox=event.target.closest('[data-activity-admin-meeting]');if(checkbox)updateActivityAdminCheck(checkbox)});el('nav-activity-analytics').onclick=()=>{showPage('activity-analytics');selectActivityView(activityActiveView)};\n</script>\n",
  "ClientAiProviderSettings": "<script>\nlet aiProviderAdminState=null;\nlet aiProviderAdminBusy=false;\nlet activeAdminTab='provider';\nfunction aiProviderAdminElement(id){return document.getElementById(id)}\nfunction selectAdminTab(tab,focus){\n  if(tab!=='provider'&&tab!=='deleted'&&tab!=='theme')return;\n  activeAdminTab=tab;\n  document.querySelectorAll('[data-admin-tab]').forEach(button=>{const selected=button.dataset.adminTab===tab;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected));button.tabIndex=selected?0:-1;if(selected&&focus)button.focus()});\n  aiProviderAdminElement('admin-panel-provider').hidden=tab!=='provider';\n  aiProviderAdminElement('admin-panel-deleted').hidden=tab!=='deleted';\n  aiProviderAdminElement('admin-panel-theme').hidden=tab!=='theme';\n}\nfunction adminTabKeydown(event){\n  if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;\n  event.preventDefault();const tabs=['provider','deleted','theme'];let index=tabs.indexOf(activeAdminTab);\n  if(event.key==='Home')index=0;else if(event.key==='End')index=tabs.length-1;else index=(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;\n  selectAdminTab(tabs[index],true);\n}\nfunction aiProviderAdminStatusLabel(value){return value==='ACTIVE'?'有効':value==='ACTIVE_WITH_SYNC_ERRORS'?'有効（一部同期エラー）':value==='READY_FOR_SYNC'?'同期準備完了':value==='READY_FOR_QUALIFICATION'?'利用確認待ち':value==='QUALIFIED_DISABLED'?'利用確認済み（無効）':value==='DISABLED_EXTERNAL_LIMITATION'?'利用不可':value==='TESTING'?'接続確認中':value==='RECONNECT_REQUIRED'?'再接続が必要':value==='ERROR'?'エラー':value==='UNCONFIGURED'?'未設定':'無効'}\nfunction aiModelAdminQualificationLabel(value){return value==='QUALIFIED'||value==='AVAILABLE'?'利用可':value==='FAILED'||value==='UNAVAILABLE'?'利用不可':value==='STALE'?'再確認が必要':'未確認'}\nfunction aiProviderAdminBooleanLabel(value){return value?'設定済み':'未設定'}\nfunction aiProviderAdminStoreLabel(value){return value?'準備済み':'未作成'}\nfunction aiModelAdminProfiles(){return aiProviderAdminState&&aiProviderAdminState.modelPolicy&&Array.isArray(aiProviderAdminState.modelPolicy.profiles)?aiProviderAdminState.modelPolicy.profiles:[]}\nfunction aiProviderAdminSetBusy(busy){aiProviderAdminBusy=busy;kspSetRegionBusy(aiProviderAdminElement('admin-panel-provider'),busy);const canMutate=Boolean(aiProviderAdminState&&aiProviderAdminState.canMutate);['ai-provider-openai-key-input','ai-provider-sync-source','ai-provider-sync-source-id','ai-provider-openai-enable','ai-provider-openai-disable','ai-provider-openai-sync','ai-provider-gemini-key-input','ai-provider-gemini-sync-source','ai-provider-gemini-sync-source-id','ai-provider-gemini-connect','ai-provider-gemini-enable','ai-provider-gemini-disable','ai-provider-gemini-sync','ai-model-profile-select','ai-model-profile-id','ai-model-provider','ai-model-id','ai-model-display-name','ai-model-family','ai-model-max-output','ai-model-thinking-profiles','ai-model-default-thinking','ai-model-enabled','ai-model-user-visible','ai-model-provider-default','ai-model-policy-migrate','ai-model-profile-save','ai-model-profile-qualify'].forEach(id=>{const node=aiProviderAdminElement(id);if(node)node.disabled=busy||!canMutate})}\nfunction aiModelAdminRenderProfile(profile){const value=profile||{};aiProviderAdminElement('ai-model-profile-id').value=value.profileId||'';aiProviderAdminElement('ai-model-provider').value=value.provider||'OPENAI';aiProviderAdminElement('ai-model-id').value=value.modelId||'';aiProviderAdminElement('ai-model-display-name').value=value.displayName||'';aiProviderAdminElement('ai-model-family').value=value.family||'';aiProviderAdminElement('ai-model-max-output').value=value.maxOutputTokens==null?'':String(value.maxOutputTokens);aiProviderAdminElement('ai-model-thinking-profiles').value=(value.thinkingProfiles||[]).map(item=>[item.thinkingProfileId,item.label,item.providerDefault?'':(item.rawValue||'')].join(' | ')).join('\\n');aiProviderAdminElement('ai-model-default-thinking').value=value.defaultThinkingProfileId||'provider-default';aiProviderAdminElement('ai-model-enabled').checked=value.enabled!==false;aiProviderAdminElement('ai-model-user-visible').checked=value.userVisible!==false;aiProviderAdminElement('ai-model-provider-default').checked=Boolean(value.isProviderDefault);aiProviderAdminElement('ai-model-access-state').textContent=aiModelAdminQualificationLabel(value.apiAccess);aiProviderAdminElement('ai-model-qualification-state').textContent=aiModelAdminQualificationLabel(value.qualification);aiProviderAdminElement('ai-model-thinking-qualification-state').textContent=(value.thinkingProfiles||[]).map(item=>(item.label||item.thinkingProfileId)+': '+aiModelAdminQualificationLabel(item.qualification)).join(' / ')||'未登録';aiProviderAdminElement('ai-model-profile-qualify').disabled=aiProviderAdminBusy||!Boolean(aiProviderAdminState&&aiProviderAdminState.canMutate)||!Boolean(value.profileId)}\nfunction aiModelAdminRenderPolicy(data){const select=aiProviderAdminElement('ai-model-profile-select');const prior=select.value;select.innerHTML='<option value=\"\">新規作成</option>';aiModelAdminProfiles().forEach(profile=>{const option=document.createElement('option');option.value=profile.profileId;option.textContent=(profile.isProviderDefault?'★ ':'')+profile.displayName+' / '+profile.modelId;select.appendChild(option)});const selected=aiModelAdminProfiles().find(profile=>profile.profileId===prior)||aiModelAdminProfiles().find(profile=>profile.isProviderDefault)||aiModelAdminProfiles()[0];if(selected){select.value=selected.profileId;aiModelAdminRenderProfile(selected)}else{select.value='';aiModelAdminRenderProfile(null)}const migrate=aiProviderAdminElement('ai-model-policy-migrate');if(migrate)migrate.textContent=data&&data.modelPolicyPersisted?'ポリシー再確認':'現行設定から初期化'}\nfunction renderAiProviderAdminData(data){const openai=data&&data.openai?data.openai:{};const gemini=data&&data.gemini?data.gemini:{};aiProviderAdminElement('ai-provider-openai-key').textContent=aiProviderAdminBooleanLabel(Boolean(openai.keyConfigured));aiProviderAdminElement('ai-provider-openai-store').textContent=aiProviderAdminStoreLabel(Boolean(openai.vectorStoreReady));aiProviderAdminElement('ai-provider-openai-status').textContent=aiProviderAdminStatusLabel(String(openai.status||'DISABLED'));aiProviderAdminElement('ai-provider-gemini-key').textContent=aiProviderAdminBooleanLabel(Boolean(gemini.keyConfigured));aiProviderAdminElement('ai-provider-gemini-store').textContent=aiProviderAdminStoreLabel(Boolean(gemini.storeReady));aiProviderAdminElement('ai-provider-gemini-status').textContent=aiProviderAdminStatusLabel(String(gemini.status||'DISABLED'));const readonly=aiProviderAdminElement('ai-provider-openai-readonly');readonly.textContent=data&&data.canMutate?'この画面から設定を変更できます。':'設定の状態を読み込めません。';aiModelAdminRenderPolicy(data);aiProviderAdminSetBusy(false)}\nasync function loadAiProviderAdminData(preserveNotice){aiProviderAdminSetBusy(true);if(!preserveNotice)clearStatus('ai-provider-admin-notice');try{const result=await serverCall('getAiProviderAdminData',{});if(!result||!result.ok){aiProviderAdminState=null;renderAiProviderAdminData({});showStatus('ai-provider-admin-notice','error','AI設定を読み込めませんでした。');return}aiProviderAdminState=result;renderAiProviderAdminData(result)}catch(error){aiProviderAdminState=null;renderAiProviderAdminData({});showStatus('ai-provider-admin-notice','error','AI設定を読み込めませんでした。')}}\nfunction aiProviderAdminSyncMessage(sync){const counts=`対象 ${Number(sync&&sync.selected||0)}件 / 同期 ${Number(sync&&sync.indexed||0)}件 / 登録情報の更新 ${Number(sync&&sync.metadataRefreshed||0)}件 / 変更なし ${Number(sync&&sync.unchanged||0)}件 / 検索データから削除 ${Number(sync&&sync.removed||0)}件 / 失敗 ${Number(sync&&sync.failed||0)}件`;return sync&&sync.partial?`一部の資料を同期できませんでした。${counts}`:`同期を完了しました。${counts}`}\nfunction aiProviderAdminBusyLabel(action){return action==='SYNC'||action==='SYNC_GEMINI'?'同期中…':action==='DISABLE_OPENAI'||action==='DISABLE_GEMINI'?'無効化中…':action==