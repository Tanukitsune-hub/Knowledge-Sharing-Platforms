yedropper');button.hidden=false;\n    button.addEventListener('click',async()=>{try{const result=await new window.EyeDropper().open();if(result&&themeSettingsHex(result.sRGBHex))themeColorToolLoad(result.sRGBHex)}catch(ignored){/* Cancel is not an error. */}});\n  }\n}\nfunction themeSettingsDerivedHex(sourceHex,sourceDefaultHex,targetDefaultHex){const source=themeSettingsChannels(sourceHex),sourceDefault=themeSettingsChannels(sourceDefaultHex),targetDefault=themeSettingsChannels(targetDefaultHex);return themeSettingsChannelsHex(source.map((value,index)=>value+targetDefault[index]-sourceDefault[index]))}\nfunction themeSettingsCssVariables(palette){\n  const variables={};\n  themeSettingsState.definitions.forEach(definition=>{variables[definition.cssVariable]=palette[definition.key]});\n  themeSettingsState.derivedRules.forEach(rule=>{variables[rule.cssVariable]=themeSettingsDerivedHex(palette[rule.sourceKey],rule.sourceDefaultHex,rule.defaultHex)});\n  return variables;\n}\nfunction themeSettingsApplyPreview(palette){const style=document.documentElement.style;Object.entries(themeSettingsCssVariables(palette)).forEach(([name,value])=>style.setProperty(name,value))}\nfunction themeSettingsSame(left,right){return themeSettingsState.definitions.every(definition=>left[definition.key]===right[definition.key])}\nfunction themeSettingsStatus(kind,message){showStatus('theme-settings-status',kind,message)}\nfunction themeSettingsSetBusy(busy,trigger,label){\n  themeSettingsBusy=busy;\n  if(busy&&trigger)themeSettingsBusyButton=trigger;\n  if(themeSettingsBusyButton)kspSetActionBusy(themeSettingsBusyButton,busy,label||'処理中…');\n  if(!busy)themeSettingsBusyButton=null;\n  kspSetRegionBusy(themeSettingsElement('admin-panel-theme'),busy);\n  ['theme-settings-save','theme-settings-discard','theme-settings-reset'].forEach(id=>{themeSettingsElement(id).disabled=busy});\n  document.querySelectorAll('[data-theme-color],[data-theme-hex]').forEach(node=>{node.disabled=busy});\n  ['theme-color-hue','theme-color-hex','theme-color-copy','theme-color-target','theme-color-eyedropper'].forEach(id=>{themeSettingsElement(id).disabled=busy});\n  themeSettingsElement('theme-color-sv').setAttribute('aria-disabled',String(busy));\n  if(themeColorToolState)themeColorToolRender();\n}\nfunction themeSettingsContrastRatio(left,right){\n  const luminance=hex=>{const channels=themeSettingsChannels(hex).map(value=>{const normalized=value/255;return normalized<=.03928?normalized/12.92:Math.pow((normalized+.055)/1.055,2.4)});return .2126*channels[0]+.7152*channels[1]+.0722*channels[2]};\n  const first=luminance(left),second=luminance(right);return(Math.max(first,second)+.05)/(Math.min(first,second)+.05)\n}\nfunction themeSettingsRenderContrast(){\n  const palette=themeSettingsDraft;\n  const softSurface=themeSettingsCssVariables(palette)['--theme-main-surface-soft'];\n  const pairs=[\n    ['Sidebar 文字 / 背景',palette['sidebar.text'],palette['sidebar.background']],\n    ['メイン文字 / ページ背景',palette['text.primary'],palette['main.pageBackground']],\n    ['メイン文字 / Card背景',palette['text.primary'],palette['main.cardBackground']],\n    ['メイン文字 / Section見出し',palette['text.primary'],palette['main.sectionHeader']],\n    ['補助文字 / ページ背景',palette['text.secondary'],palette['main.pageBackground']],\n    ['補助文字 / Card背景',palette['text.secondary'],palette['main.cardBackground']],\n    ['補助文字 / soft surface',palette['text.secondary'],softSurface],\n    ['白文字 / Primary button','#FFFFFF',palette['action.primary']]\n  ];\n  const warnings=pairs.map(pair=>({label:pair[0],ratio:themeSettingsContrastRatio(pair[1],pair[2])})).filter(item=>item.ratio<4.5);\n  if(warnings.length){showStatus('theme-contrast-warning','warning','コントラスト注意: '+warnings.map(item=>item.label+' '+item.ratio.toFixed(2)+':1').join(' / '))}\n  else clearStatus('theme-contrast-warning');\n}\nfunction themeSettingsHasInvalid(){return[...document.querySelectorAll('[data-theme-hex]')].some(node=>node.getAttribute('aria-invalid')==='true')}\nfunction themeSettingsRefreshState(){\n  const dirty=!themeSettingsSame(themeSettingsDraft,themeSettingsState.palette);\n  const invalid=themeSettingsHasInvalid();\n  const saveAllowed=!themeSettingsBusy&&!invalid&&(dirty||!themeSettingsState.persisted);\n  themeSettingsElement('theme-settings-save').disabled=!saveAllowed;\n  themeSettingsElement('theme-settings-discard').disabled=themeSettingsBusy||!dirty;\n  themeSettingsElement('theme-settings-state').textContent=(themeSettingsState.persisted?'共有設定を適用中':'既定の配色を使用中')+(dirty?' / 未保存のプレビュー':'');\n  themeSettingsRenderContrast();\n  return{dirty,invalid,saveAllowed};\n}\nfunction themeSettingsMarkPreview(){const state=themeSettingsRefreshState();if(state.invalid)themeSettingsStatus('error','色は#RRGGBB形式で入力してください。');else if(state.dirty)themeSettingsStatus('info','未保存のプレビュー');else clearStatus('theme-settings-status')}\nfunction themeSettingsFillInputs(){\n  themeSettingsState.definitions.forEach((definition,index)=>{\n    const value=themeSettingsDraft[definition.key];\n    themeSettingsElement('theme-color-'+index).value=value;\n    const input=themeSettingsElement('theme-hex-'+index);input.value=value;input.setAttribute('aria-invalid','false');\n  });\n  if(themeColorToolState)themeColorToolLoad(themeSettingsDraft[themeColorToolState.activeKey]);\n}\nfunction themeSettingsRenderFields(){\n  const host=themeSettingsElement('theme-settings-groups');host.innerHTML='';\n  const groups=[];themeSettingsState.definitions.forEach(definition=>{if(!groups.includes(definition.group))groups.push(definition.group)});\n  groups.forEach(group=>{\n    const section=document.createElement('section');section.className='theme-settings-group';\n    const heading=document.createElement('h3');heading.textContent=group;section.appendChild(heading);\n    const grid=document.createElement('div');grid.className='theme-settings-grid';section.appendChild(grid);\n    themeSettingsState.definitions.forEach((definition,index)=>{\n      if(definition.group!==group)return;\n      const row=document.createElement('div');row.className='theme-setting-row';row.dataset.themeKey=definition.key;\n      const label=document.createElement('label');label.htmlFor='theme-hex-'+index;label.className='theme-setting-label';\n      const title=document.createElement('strong');title.textContent=definition.label;const meta=document.createElement('span');meta.textContent=definition.colorName+' / 既定 '+definition.defaultHex;label.append(title,meta);\n      const picker=document.createElement('input');picker.id='theme-color-'+index;picker.type='color';picker.value=themeSettingsDraft[definition.key];picker.dataset.themeColor=definition.key;picker.setAttribute('aria-label',definition.label+' カラーピッカー');\n      const hex=document.createElement('input');hex.id='theme-hex-'+index;hex.type='text';hex.value=themeSettingsDraft[definition.key];hex.maxLength=7;hex.pattern='#[0-9A-Fa-f]{6}';hex.autocomplete='off';hex.spellcheck=false;hex.dataset.themeHex=definition.key;hex.setAttribute('aria-label',definition.label+' HEX');hex.setAttribute('aria-invalid','false');\n      row.addEventListener('pointerdown',()=>themeColorToolSelectKey(definition.key));\n      row.addEventListener('focusin',()=>{if(themeColorToolState.activeKey!==definition.key)themeColorToolSelectKey(definition.key)});\n      picker.addEventListener('input',()=>{const value=picker.value.toUpperCase();themeSettingsDraft[definition.key]=value;hex.value=value;hex.setAttribute('aria-invalid','false');if(themeColorToolState.activeKey===definition.key)themeColorToolLoad(value);themeSettingsApplyPreview(themeSettingsDraft);themeSettingsMarkPreview()});\n      hex.addEventListener('input',()=>{const value=themeSettingsHex(hex.value);hex.setAttribute('aria-invalid',String(!value));if(value){hex.value=value;picker.value=value;themeSettingsDraft[definition.key]=value;if(themeColorToolState.activeKey===definition.key)themeColorToolLoad(value);themeSettingsApplyPreview(themeSettingsDraft)}themeSettingsMarkPreview()});\n      row.append(label,picker,hex);grid.appendChild(row);\n    });\n    host.appendChild(section);\n  });\n}\nfunction themeSettingsAcceptState(result){themeSettingsState=themeSettingsClone(result);themeSettingsDraft=themeSettingsClone(result.palette);themeSettingsFillInputs();themeSettingsApplyPreview(themeSettingsDraft);themeSettingsRefreshState()}\nasync function themeSettingsSave(){\n  if(themeSettingsBusy||themeSettingsHasInvalid()||(themeSettingsState.persisted&&themeSettingsSame(themeSettingsDraft,themeSettingsState.palette)))return;\n  themeSettingsSetBusy(true,themeSettingsElement('theme-settings-save'),'保存中…');themeSettingsStatus('info busy','テーマ設定を保存中…');\n  try{const result=await serverCall('mutateThemeSettings',{action:'SAVE',palette:themeSettingsDraft});if(!result||!result.ok)throw new Error(result&&result.error&&result.error.message||'テーマ設定を保存できませんでした。');themeSettingsAcceptState(result);themeSettingsStatus('success','保存しました')}\n  catch(error){themeSettingsStatus('error',error.message||'テーマ設定を保存できませんでした。')}\n  finally{themeSettingsSetBusy(false);themeSettingsRefreshState()}\n}\nfunction themeSettingsDiscard(){if(themeSettingsBusy)return;themeSettingsDraft=themeSettingsClone(themeSettingsState.palette);themeSettingsFillInputs();themeSettingsApplyPreview(themeSettingsDraft);themeSettingsRefreshState();themeSettingsStatus('info','変更を破棄しました。')}\nasync function themeSettingsReset(){\n  if(themeSettingsBusy||!window.confirm('保存済みのテーマ設定を削除し、既定の配色に戻しますか？'))return;\n  themeSettingsSetBusy(true,themeSettingsElement('theme-settings-reset'),'初期化中…');themeSettingsStatus('info busy','既定の配色へ戻しています…');\n  try{const result=await serverCall('mutateThemeSettings',{action:'RESET'});if(!result||!result.ok)throw new Error(result&&result.error&&result.error.message||'既定の配色に戻せませんでした。');themeSettingsAcceptState(result);themeSettingsStatus('success','既定の配色に戻しました')}\n  catch(error){themeSettingsStatus('error',error.message||'既定の配色に戻せませんでした。')}\n  finally{themeSettingsSetBusy(false);themeSettingsRefreshState()}\n}\nthemeSettingsState=themeSettingsBootstrap();\nif(themeSettingsState){\n  themeSettingsDraft=themeSettingsClone(themeSettingsState.palette);themeSettingsRenderFields();themeColorToolInit();themeSettingsApplyPreview(themeSettingsDraft);themeSettingsRefreshState();\n  if(themeSettingsState.corruptOverrideIgnored)themeSettingsStatus('warning','保存済みテーマを確認できなかったため、既定の配色を表示しています。');\n  themeSettingsElement('theme-settings-save').addEventListener('click',themeSettingsSave);\n  themeSettingsElement('theme-settings-discard').addEventListener('click',themeSettingsDiscard);\n  themeSettingsElement('theme-settings-reset').addEventListener('click',themeSettingsReset);\n}else{\n  themeSettingsSetBusy(true);themeSettingsStatus('error','テーマ設定を読み込めませんでした。');\n}\n</script>\n",
  "DeploymentSecurityOperator": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>デプロイ設定の確認</title>\n  <style>\n    body { font-family: sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1.25rem; color: #172b3a; background: #fff; }\n    button { padding: .75rem 1.25rem; font: inherit; cursor: pointer; }\n    button:disabled { cursor: default; }\n    #result { white-space: pre-wrap; margin-top: 1.5rem; }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>デプロイ設定の確認</h1>\n    <p>管理者専用の操作です。実行ユーザーとアクセス範囲が承認済みの設定であることを、Apps Scriptのデプロイ設定で確認してから実行してください。</p>\n    <p>ページを開くだけでは設定を変更しません。権限はサーバー側で確認します。</p>\n    <button id=\"confirm-deployment\" type=\"button\">承認済みのデプロイ設定を確認する</button>\n    <p id=\"result\" role=\"status\" aria-live=\"polite\">未実行</p>\n  </main>\n  <script>\n    (function () {\n      'use strict';\n      var button = document.getElementById('confirm-deployment');\n      var result = document.getElementById('result');\n      var submitted = false;\n      var states = ['READY', 'READY_FOR_DEPLOYMENT', 'ACTION_REQUIRED', 'FAILED'];\n      var codes = [\n        'INSTALLER_BOUND_SPREADSHEET_REQUIRED', 'INSTALLER_PARENT_AMBIGUOUS',\n        'INSTALLER_ACTIVE_USER_REQUIRED', 'INSTALLER_ADMIN_REQUIRED',\n        'INSTALLER_OWNER_LATCH_INVALID', 'INSTALLER_OWNER_CONFIG_CONFLICT',\n        'INSTALLATION_STATE_MISSING', 'SETUP_LOCK_TIMEOUT',\n        'WEB_APP_DEPLOYMENT_REQUIRED', 'WEB_APP_DEPLOYMENT_IDENTITY_INVALID',\n        'DEPLOYMENT_SECURITY_ATTESTATION_REQUIRED', 'DEPLOYMENT_SECURITY_ATTESTATION_INVALID',\n        'DEPLOYMENT_SECURITY_ATTESTATION_STALE'\n      ];\n      function failed() {\n        result.textContent = 'FAILED / INSTALLER_FAILED\\n管理者が導入状態を確認してください。';\n      }\n      button.addEventListener('click', function () {\n        if (submitted) return;\n        submitted = true;\n        button.disabled = true;\n        result.textContent = '確認中';\n        try {\n          google.script.run.withSuccessHandler(function (status) {\n            var state = status && states.indexOf(status.state) !== -1 ? status.state : 'FAILED';\n            var code = status && status.error ?\n              (codes.indexOf(status.error.code) !== -1 ? status.error.code : 'INSTALLER_FAILED') :\n              (state === 'READY' ? 'NONE' : 'INSTALLER_FAILED');\n            result.textContent = state + ' / ' + code;\n          }).withFailureHandler(failed).confirmKnowledgeShareDeploymentSecurity();\n        } catch (ignored) {\n          failed();\n        }\n      });\n    }());\n  </script>\n</body>\n</html>\n",
  "EntityWorkspacePage": "<section id=\"page-entity-workspace\" class=\"page\">\n  <div class=\"card\">\n    <div class=\"section-heading\">\n      <div><h2>面談先サマリー</h2><p class=\"hint\">面談先ごとの面談記録、保存資料、関連付けをまとめて表示します。</p></div>\n      <button id=\"entity-workspace-print-button\" class=\"action secondary\" type=\"button\" disabled>印刷 / PDF</button>\n    </div>\n    <div class=\"filter-grid entity-workspace-selector-grid\">\n      <div class=\"field\"><label for=\"entity-workspace-entity\">面談先</label><select id=\"entity-workspace-entity\"><option value=\"\">未選択</option></select></div>\n    </div>\n    <div id=\"entity-workspace-status\" class=\"status\" role=\"status\" aria-live=\"polite\"></div>\n  </div>\n\n  <div id=\"entity-workspace-content\" class=\"entity-workspace-content hidden-panel\">\n    <div class=\"card entity-workspace-header\"><div><h2 id=\"entity-workspace-name\"></h2><p id=\"entity-workspace-identity\" class=\"hint\" hidden></p></div><span id=\"entity-workspace-entity-status\" class=\"badge\"></span></div>\n    <div id=\"entity-workspace-summary\" class=\"entity-summary-grid\" aria-live=\"polite\"></div>\n\n    <section class=\"card\"><div class=\"section-heading\"><div><h3>Fund / Strategy</h3><p class=\"hint\">登録された名称ごとに集計します。行を選ぶと詳細を表示します。</p></div></div><div class=\"field entity-workspace-fund-selector\"><label for=\"entity-workspace-fund\">詳細対象</label><select id=\"entity-workspace-fund\"><option value=\"\">未選択</option></select></div><div class=\"table-wrap\"><table class=\"data-table entity-workspace-table\"><caption class=\"sr-only\">Fund / Strategy集計</caption><thead><tr><th>Fund / Strategy</th><th>面談記録</th><th>保存資料</th><th>直接 / 関連</th><th>最後の面談日</th><th>関連付け</th></tr></thead><tbody id=\"entity-workspace-funds\"></tbody></table></div><div id=\"entity-workspace-funds-more\"></div><div id=\"entity-workspace-drill\" class=\"entity-workspace-drill\" role=\"region\" aria-live=\"polite\"></div></section>\n\n    <section id=\"entity-workspace-counter