  "ClientPitchbookFiles": "<script>\n\nfunction fileDescriptor(file,index){return{ordinal:index+1,originalFilename:file.name,sizeBytes:file.size,mimeType:file.type||'application/octet-stream'}}\nfunction extension(name){const m=/\\.([^.]+)$/.exec(name||'');return m?m[1].toLowerCase():''}\nfunction validateFiles(files){if(!files.length)return'ファイルを1つ以上選択してください。';if(files.length>KSP_PITCHBOOK_LIMITS.fileCount)return'ファイルは10件までです。';let total=0;for(const file of files){if(file.size<=0)return'空のファイルは登録できません。';if(file.size>KSP_PITCHBOOK_LIMITS.fileBytes)return file.name+' は25MBを超えています。';if(!KSP_ALLOWED_EXTENSIONS.includes(extension(file.name)))return file.name+' は対応形式ではありません。';total+=file.size}if(total>KSP_PITCHBOOK_LIMITS.totalBytes)return'合計サイズは100MBまでです。';return''}\nfunction formatBytes(bytes){if(bytes<1024)return bytes+' B';if(bytes<1024*1024)return(bytes/1024).toFixed(1)+' KB';return(bytes/1024/1024).toFixed(1)+' MB'}\nlet pitchbookActionButton=null;\nfunction pitchbookShowStatus(kind,message){showStatus('pitchbook-status',kind,message);if(pitchbookMode==='standalone')showStatus('standalone-pitchbook-status',kind,message)}\nfunction pitchbookSetDisabled(button,disabled){if(disabled&&!pitchbookBusy&&document.activeElement===button)el('pitchbook-status').focus({preventScroll:true});button.disabled=disabled}\nfunction setPitchbookBusy(busy,trigger){pitchbookBusy=busy;if(busy&&trigger)pitchbookActionButton=trigger;if(busy&&!pitchbookActionButton)pitchbookActionButton=el('pitchbook-submit');if(pitchbookActionButton)kspSetActionBusy(pitchbookActionButton,busy,pitchbookActionButton===el('pitchbook-retry')?'再試行中…':'資料を保存中…');if(!busy)pitchbookActionButton=null;const submit=el('pitchbook-submit'),retry=el('pitchbook-retry');pitchbookSetDisabled(submit,!kspActionKeepsFocus(submit)&&(busy||pitchbookLoading||!pitchbookParent||!selectedPitchbookFiles.length||Boolean(pitchbookSlots.length)));pitchbookSetDisabled(retry,!kspActionKeepsFocus(retry)&&(busy||(pitchbookMode!=='standalone'&&!pitchbookParent)||!(pitchbookSlots.some(slot=>!slot.linkConfirmed)||pendingExistingDocumentIds.length||selectedPitchbookFiles.length||pitchbookPrepareRequest)));el('pitchbook-clear').disabled=busy;const standalone=el('standalone-pitchbook-submit');if(standalone)pitchbookSetDisabled(standalone,!kspActionKeepsFocus(standalone)&&(busy||pitchbookLoading));fileInput.disabled=busy;kspSetRegionBusy(el('meeting-file-panel'),busy)}\nfunction savePitchbookSlots(){if(pitchbookParent||pitchbookSlots.length||pitchbookPrepareUnknown||pitchbookPrepareRequest||pendingExistingDocumentIds.length)writeEnvelope(KSP_PITCHBOOK_SLOT_KEY,{mode:pitchbookMode,parent:pitchbookMode==='standalone'?null:pitchbookParent,slots:pitchbookSlots,pendingExistingDocumentIds,prepareUnknown:pitchbookPrepareUnknown,prepareRequest:pitchbookPrepareRequest});else safeRemove(KSP_PITCHBOOK_SLOT_KEY)}\nfunction restorePitchbookSlots(){const saved=readEnvelope(KSP_PITCHBOOK_SLOT_KEY);pitchbookSlots=Array.isArray(saved)?saved:(saved&&saved.slots||[]);pitchbookParent=saved&&!Array.isArray(saved)?saved.parent:null;pitchbookMode=saved&&saved.mode==='standalone'?'standalone':'meeting';pendingExistingDocumentIds=saved&&saved.pendingExistingDocumentIds||[];pitchbookPrepareUnknown=Boolean(saved&&saved.prepareUnknown);pitchbookPrepareRequest=saved&&saved.prepareRequest||null;renderPitchbookFiles();if(pitchbookParent){el('pitchbook-parent-label').textContent='保存済み親記録: '+pitchbookParent.meetingId+'（再試行前に最新状態を照合します）';setRegisteredMeetingLocked(true);el('pitchbook-submit').hidden=false;el('pitchbook-submit').disabled=true}if(pitchbookSlots.length||pitchbookPrepareRequest)pitchbookShowStatus('warning','未完了の資料保存を復元しました。ファイル未保存分だけ原本を再選択して再試行してください。')}\nfunction renderPitchbookFiles(){\n  const list=el('pitchbook-file-list');list.innerHTML='';\n  const rows=pitchbookSlots.length?pitchbookSlots:selectedPitchbookFiles.map((file,index)=>({ordinal:index+1,originalFilename:file.name,status:'Selected',sizeBytes:file.size}));\n  rows.forEach(row=>{\n    const wrap=document.createElement('div');wrap.className='file-row';\n    const identity=document.createElement('details');identity.className='file-identity';\n    const summary=document.createElement('summary'),marker=document.createElement('span'),name=document.createElement('span');marker.className='file-identity-marker';marker.setAttribute('aria-hidden','true');name.className='file-primary-name';name.textContent=row.originalFilename;summary.append(marker,name);identity.appendChild(summary);\n    const detail=document.createElement('div');detail.className='file-detail';detail.textContent='元ファイル名: '+row.originalFilename+(row.savedFilename?' / 保存名: '+row.savedFilename:'');identity.appendChild(detail);\n    const size=document.createElement('div');size.className='file-size';size.textContent=row.sizeBytes?formatBytes(row.sizeBytes):'';\n    const badge=document.createElement('span');badge.className='badge '+String(row.status||'');badge.textContent=row.linkConfirmed?'関連付け済み':row.fileSaved?'保存済み・関連付け未完了':row.outcomeUnknown?'保存結果を確認中':(row.status||'');\n    wrap.append(identity,size,badge);list.appendChild(wrap)\n  });\n  const total=selectedPitchbookFiles.reduce((sum,file)=>sum+file.size,0);el('pitchbook-file-summary').textContent=selectedPitchbookFiles.length?selectedPitchbookFiles.length+'件 / '+formatBytes(total):(pitchbookSlots.length?'ファイルを再選択すると失敗分を再試行できます。':'');setPitchbookBusy(pitchbookBusy)\n}\nfunction matchReselectedFiles(files){if(!pitchbookSlots.length)return;const pool=[...files];pitchbookSlots.forEach(slot=>{const index=pool.findIndex(file=>file.name===slot.originalFilename&&(!slot.sizeBytes||file.size===slot.sizeBytes));if(index>=0)pool.splice(index,1)})}\nfunction setSelectedFiles(files){const array=[...files];if(!array.length){selectedPitchbookFiles=[];kspSetInlineError(el('pitchbook-drop-zone'),'');renderPitchbookFiles();clearStatus('pitchbook-status');return}const error=validateFiles(array);if(error){kspSetInlineError(el('pitchbook-drop-zone'),error);pitchbookShowStatus('error',error);return}const priorFileError=el('pitchbook-status').classList.contains('error')?el('pitchbook-status').textContent:'';selectedPitchbookFiles=array;kspSetInlineError(el('pitchbook-drop-zone'),'');matchReselectedFiles(array);renderPitchbookFiles();clearStatus('pitchbook-status');if(pitchbookMode==='standalone'){const primary=el('standalone-pitchbook-status');if(primary.classList.contains('success')||primary.classList.contains('error')&&(primary.textContent==='ファイルを1つ以上選択してください。'||primary.textContent===priorFileError))clearStatus('standalone-pitchbook-status')}}\nconst drop=el('pitchbook-drop-zone'),fileInput=el('pitchbook-files');drop.onclick=()=>fileInput.click();drop.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();fileInput.click()}};['dragenter','dragover'].forEach(name=>drop.addEventListener(name,e=>{e.preventDefault();drop.classList.add('dragover')}));['dragleave','drop'].forEach(name=>drop.addEventListener(name,e=>{e.preventDefault();drop.classList.remove('dragover')}));drop.addEventListener('drop',e=>setSelectedFiles(e.dataTransfer.files));fileInput.onchange=()=>setSelectedFiles(fileInput.files);\nfunction pitchbookMetadata(){const prefix=pitchbookMode==='standalone'?'pitchbook':'meeting';return{date:el(prefix+'-date').value,counterpartyId:pitchbookMode==='standalone'?el('pitchbook-counterpartyId').value:el('meeting-counterpartyId').value,assetClassId:el(prefix+'-assetClassId').value,capitalTypeId:el(prefix+'-capitalTypeId').value,fundStrategy:el(prefix+'-fundStrategy').value}}\nfunction fileForSlot(slot){const direct=selectedPitchbookFiles[Math.max(0,(slot.ordinal||1)-1)];if(direct&&direct.name===slot.originalFilename&&(!slot.sizeBytes||direct.size===slot.sizeBytes))return direct;return selectedPitchbookFiles.find(file=>file.name===slot.originalFilename&&(!slot.sizeBytes||file.size===slot.sizeBytes))||null}\nfunction readBase64(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||'').split('base64,')[1]||'');reader.onerror=()=>reject(reader.error||new Error('ファイルを読み込めませんでした。'));reader.readAsDataURL(file)})}\n</script>\n",
  "ClientPitchbookFlow": "<script>\nlet pitchbookParent=null,pitchbookBusy=false,meetingFlowBusy=false,pendingExistingDocumentIds=[],pitchbookPrepareUnknown=false,pitchbookPrepareRequest=null,pitchbookMode='meeting';\nfunction bindPitchbookParent(record,existing){\n  if(!record||!record.meetingId||!Number.isInteger(Number(record.version))||Number(record.version)<1||record.status!=='Active')throw new Error('保存済みActive記録のIDとVersionを確認できません。');\n  if(pitchbookSlots.some(slot=>slot.parentMeetingId!==record.meetingId))throw new Error('別の親記録の未完了資料があります。先にその記録で回復してください。');\n  pitchbookMode='meeting';\n  pitchbookParent={meetingId:record.meetingId,version:Number(record.version),existing:Boolean(existing)};\n  el('pitchbook-parent-label').textContent='親記録: '+record.meetingId+' / 更新番号 '+record.version+'（新規記録は作成しません）';\n  el('pitchbook-submit').hidden=!existing;savePitchbookSlots();\n}\nasync function readPitchbookParent(){\n  if(!pitchbookParent)throw new Error('先に親記録を保存してください。');\n  const result=await serverCall('getMeetingMaintenanceRecord',pitchbookParent.meetingId);\n  if(!result||!result.ok||!result.record||result.record.status!=='Active')throw new Error('親記録の状態を確認できません。再送は行いません。');\n  pitchbookParent.version=Number(result.record.version);return result.record;\n}\nasync function linkParentDocument(documentId,operation){\n  const record=await readPitchbookParent(),ids=record.relatedPitchbookIds||[];\n  if(operation==='add'&&ids.includes(documentId)||operation==='remove'&&!ids.includes(documentId))return{ok:true,meetingId:record.meetingId,version:record.version,relatedPitchbookIds:ids};\n  const result=await serverCall('updateMeetingRelations',{meetingId:record.meetingId,expectedVersion:record.version,documentId,operation});\n  if(!result||!result.ok)throw new Error(result&&result.error?result.error.message:'関連付けを確認できません。再試行時に現在の関係を照合します。');\n  pitchbookParent.version=Number(result.version);savePitchbookSlots();return result;\n}\nasync function uploadSlot(slot){\n  const standalone=pitchbookMode==='standalone';\n  if(standalone?Boolean(slot.parentMeetingId):(!pitchbookParent||slot.parentMeetingId!==pitchbookParent.meetingId))return{ok:false,slot,error:{message:'親記録の不一致により停止しました。'}};\n  try{\n    if(slot.outcomeUnknown){\n      const readback=await serverCall('getPitchbookMaintenanceRecord',slot.documentId);\n      if(!readback||!readback.ok||!readback.record)throw new Error('ファイルの保存結果が不明です。readback確認まで再uploadしません。');\n      const record=readback.record;\n      if(record.status==='Active'&&record.fileId){slot.fileSaved=true;slot.status='LinkPending'}\n      else if(record.status==='Failed'||record.status==='Pending'){slot.fileSaved=false}\n      else throw new Error('処理中または不明な資料です。再uploadしません。');\n      slot.outcomeUnknown=false;\n    }\n    if(slot.fileSaved){\n      if(standalone)return{ok:true,fileSaved:true,linkConfirmed:true,slot:{...slot,status:'Active',fileSaved:true,linkConfirmed:true,parentVersion:0}};\n      const linked=await linkParentDocument(slot.documentId,'add');\n      return{ok:true,fileSaved:true,linkConfirmed:true,slot:{...slot,status:'Active',fileSaved:true,linkConfirmed:true,parentVersion:linked.version}};\n    }\n    const parent=standalone?{meetingId:'',version:0}:await readPitchbookParent(),file=fileForSlot(slot);\n    if(!file)throw new Error(slot.originalFilename+' を再選択してください。');\n    const base64Data=await readBase64(file);\n    slot.outcomeUnknown=true;savePitchbookSlots();\n    const result=await serverCall('uploadPitchbookFile',{batchId:slot.batchId,documentId:slot.documentId,slotFingerprint:slot.slotFingerprint,parentMeetingId:slot.parentMeetingId,expectedParentVersion:parent.version,parentVersion:parent.version,originalFilename:file.name,sizeBytes:file.size,mimeType:file.type||'application/octet-stream',base64Data});\n    if(!result)throw new Error('ファイル保存結果を確認できません。');\n    const returned=result.slot||{},saved=result.fileSaved===true||returned.fileSaved===true,linked=result.linkConfirmed===true||returned.linkConfirmed===true;\n    const version=Number(result.parentVersion||returned.parentVersion||parent.version);\n    if(!standalone)pitchbookParent.version=version;pitchbookSlots.forEach(item=>{if(item.parentMeetingId===slot.parentMeetingId)item.parentVersion=version});\n    return{...result,ok:saved&&linked,slot:{...slot,...returned,parentVersion:version,fileSaved:saved,linkConfirmed:linked,outcomeUnknown:false,status:linked?'Active':saved?'LinkPending':'Failed'}};\n  }catch(error){return{ok:false,slot:{...slot,status:slot.fileSaved?'LinkPending':'Failed'},error:{message:error.message||String(error)}}}\n}\nasync function processSlots(slots){\n  const results=[];\n  for(const slot of slots){const result=await uploadSlot(slot);results.push(result);const index=pitchbookSlots.findIndex(item=>item.documentId===slot.documentId);if(index>=0)pitchbookSlots[index]={...pitchbookSlots[index],...(result.slot||{})};savePitchbookSlots();renderPitchbookFiles()}\n  return results;\n}\nfunction summarizeResults(results){\n  const failed=pitchbookSlots.filter(slot=>!slot.linkConfirmed).length+pendingExistingDocumentIds.length;\n  pitchbookShowStatus(failed?'warning':'success',failed?'保存済みIDを維持しています。未完了 '+failed+'件。未完了分を再試行してください。':pitchbookMode==='standalone'?'資料を保存しました。':'記録・資料の関連付けを完了しました。');\n  if(!failed){pitchbookPrepareRequest=null;pitchbookPrepareUnknown=false;pitchbookSlots=[];selectedPitchbookFiles=[];fileInput.value='';savePitchbookSlots();renderPitchbookFiles()}\n}\nasync function completeParentAttachments(trigger){\n  if(pitchbookBusy)return;\n  setPitchbookBusy(true,trigger);pitchbookShowStatus('info busy','資料を保存中…');\n  try{\n    if(pitchbookMode!=='standalone'&&!pitchbookParent)throw new Error('先に親記録を保存してください。');\n    if(!pitchbookSlots.length&&(selectedPitchbookFiles.length||pitchbookPrepareRequest)){\n      if(!pitchbookPrepareRequest){const error=validateFiles(selectedPitchbookFiles);if(error)throw new Error(error)}\n      const parent=pitchbookMode==='standalone'?{meetingId:'',version:0}:await readPitchbookParent();\n      if(!pitchbookPrepareRequest){\n        const admission=await serverCall('getPitchbookBootstrapData');\n        if(!admission||!admission.ok||!Number.isSafeInteger(admission.prepareRequestGeneration)||admission.prepareRequestGeneration<1)throw new Error('予約tokenを確認できません。再送は行いません。');\n        pitchbookPrepareRequest={...pitchbookMetadata(),requestId:'g'+admission.prepareRequestGeneration+'_'+crypto.randomUUID(),files:selectedPitchbookFiles.map(fileDescriptor)};\n      }\n      pitchbookPrepareUnknown=true;savePitchbookSlots();\n      const prepared=await serverCall('preparePitchbookBatch',{...pitchbookPrepareRequest,parentMeetingId:parent.meetingId,expectedParentVersion:parent.version});\n      pitchbookPrepareUnknown=false;savePitchbookSlots();\n      if(!prepared||!prepared.ok)throw new Error(prepared&&prepared.error?prepared.error.message:'資料の準備に失敗しました。');\n      pitchbookSlots=prepared.slots.map((slot,index)=>({...slot,parentMeetingId:slot.parentMeetingId||parent.meetingId,parentVersion:slot.parentVersion||parent.version,ordinal:index+1,sizeBytes:pitchbookPrepareRequest.files[index].sizeBytes}));savePitchbookSlots();\n    }\n    const results=await processSlots(pitchbookSlots.filter(slot=>!slot.linkConfirmed));\n    for(const id of pendingExistingDocumentIds.slice()){await linkParentDocument(id,'add');pendingExistingDocumentIds=pendingExistingDocumentIds.filter(item=>item!==id);savePitchbookSlots()}\n    summarizeResults(results);\n    if(pitchbookParent&&pitchbookParent.existing&&pitchbookMode!=='standalone')await openMeetingDetail(pitchbookParent.meetingId);\n    return !pitchbookSlots.length&&!pendingExistingDocumentIds.length&&!pitchbookPrepareUnknown&&!pitchbookPrepareRequest;\n  }catch(error){pitchbookShowStatus('error',error.message||String(error));return false}\n  finally{setPitchbookBusy(false);renderPitchbookFiles()}\n}\nel('pitchbook-submit').onclick=event=>completeParentAttachments(event.currentTarget);\nel('pitchbook-retry').onclick=event=>completeParentAttachments(event.currentTarget);\nel('pitchbook-clear').onclick=()=>{if(pitchbookSlots.length||pendingExistingDocumentIds.length){pitchbookShowStatus('warning','未完了IDは破棄できません。再試行または親記録で状態を確認してください。');return}selectedPitchbookFiles=[];fileInput.value='';kspSetInlineError(el('pitchbook-drop-zone'),'');renderPitchbookFiles()};\nfunction setRegisteredMeetingLocked(locked){el('meeting-form').querySelectorAll('input,select,textarea,button').forEach(node=>{if(!el('meeting-file-panel').contains(node)&&!el('meeting-file-actions').contains(node))node.disabled=locked&&!kspActionKeepsFocus(node)});el('meeting-clear').disabled=false;el('meeting-clear').textContent=locked?'新しい記録を入力':'クリア';el('meeting-entry-actions').classList.toggle('registered-parent',locked);const status=el('meeting-status');if(locked&&(!status.classList.contains('visible')||status.textContent==='面談入力の準備ができました。'))showStatus('meeting-status','info','前回保存済みの記録を表示しています。新しい記録を登録するには、ここから入力を切り替えてください。')}\n</script>\n",
  "ClientRelationshipExplorer": "<script>\nlet relationshipExplorerData=null,relationshipExplorerRequestSequence=0,relationshipExplorerLoaded=false;\nconst RELATIONSHIP_EXPLORER_FILTERS=[\n  ['counterpartyTypes','relationship-counterparty-type'],\n  ['counterpartyEntities','relationship-counterparty-entity'],\n  ['assetClasses','relationship-asset-class'],\n  ['fundStrategies','relationship-fund-strategy'],\n  ['meetingStatuses','relationship-meeting-status'],\n  ['pitchbookStatuses','relationship-pitchbook-status']\n];\nfunction relationshipText(value){return String(value==null?'':value)}\nfunction relationshipBadge(value){const text=relationshipText(value||'未設定');return '<span class=\"badge '+kspEscapeHtml(text)+'\">'+kspEscapeHtml(text)+'</span>'}\nfunction relationshipSafeLink(url,label){const safe=kspSafeDriveUrl(url);return safe?'<a class=\"small-link\" href=\"'+kspEscapeHtml(safe)+'\" target=\"_blank\" rel=\"noopener\">'+kspEscapeHtml(label)+'</a>':''}\nfunction relationshipSelectOptions(id,items){const node=el(id);if(!node)return;const current=node.value;node.innerHTML='<option value=\"\">未選択</option>';(items||[]).forEach(item=>{const option=document.createElement('option');option.value=relationshipText(item.value);option.textContent=relationshipText(item.label||item.value);node.appendChild(option)});if([...node.options].some(option=>option.value===current))node.value=current}\nfunction relationshipPayload(){return{dateFrom:el('relationship-date-from').value,dateTo:el('relationship-date-to').value,filters:{counterpartyType:el('relationship-counterparty-type').value,counterpartyEntity:el('relationship-counterparty-entity').value,assetClass:el('relationship-asset-class').value,fundStrategy:el('relationship-fund-strategy').value,meetingStatus:el('relationship-meeting-status').value,pitchbookStatus:el('relationship-pitchbook-status').value}}}\nfunction relationshipApplyFilterOptions(data){RELATIONSHIP_EXPLORER_FILTERS.forEach(([key,id])=>relationshipSelectOption