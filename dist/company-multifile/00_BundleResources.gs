<?!= include_('ClientAiProviderSettings'); ?>\n<?!= include_('ClientThemeSettings'); ?>\n<script>\nfunction meetingValues(){return{date:el('meeting-date').value,time:el('meeting-time').value,locationId:el('meeting-locationId').value,counterpartyId:el('meeting-counterpartyId').value,assetClassId:el('meeting-assetClassId').value,capitalTypeId:el('meeting-capitalTypeId').value,teamId:el('meeting-teamId').value,fundStrategy:el('meeting-fundStrategy').value,meetingTypeCodes:meetingTypeValues('meeting'),relatedPitchbookIds:selectedOptionValues('meeting-relatedPitchbookIds'),followUpRequired:el('meeting-followUpRequired').checked,followUpNote:el('meeting-followUpNote').value,counterparty:el('meeting-counterparty').value,internalParticipants:el('meeting-internalParticipants').value,notes:el('meeting-notes').value}}\nfunction saveMeetingDraft(){/* Normal input remains in this browser tab's live controls only. */}\nfunction restoreMeetingDraft(){safeRemove(KSP_SHARED_DRAFT_KEY);safeRemove(KSP_MEETING_DRAFT_KEY);const retry=readEnvelope(KSP_MEETING_RETRY_KEY);if(retry&&retry.meetingId&&retry.fingerprint){retryContext=retry;el('meeting-retry-note').classList.add('visible')}}\nfunction clearRetryContext(){retryContext=null;safeRemove(KSP_MEETING_RETRY_KEY);el('meeting-retry-note').classList.remove('visible')}\nfunction saveDraft(){saveMeetingDraft();}\nfunction clearMeetingSpecificDraft(){MEETING_FIELDS.forEach(field=>{if(el('meeting-'+field))el('meeting-'+field).value=''});setMeetingTypeValues('meeting',[]);el('meeting-followUpRequired').checked=false;refreshMeetingCounterpartyEntities('');refreshMeetingRelatedPitchbooks([]);clearRetryContext();kspClearMeetingRequiredErrors('meeting');kspSetInlineError(el('pitchbook-drop-zone'),'')}\nfunction safeStorageRemove(key){safeRemove(key)}\nfunction setMeetingBusy(busy){const submit=el('meeting-submit');kspSetActionBusy(submit,busy,'登録中…');if(!busy)submit.disabled=meetingLoading;el('meeting-clear').disabled=busy;kspSetRegionBusy(el('meeting-form'),busy)}\nMEETING_FIELDS.forEach(f=>el('meeting-'+f).addEventListener('input',saveDraft));\ndocument.querySelectorAll('[data-meeting-type=\"meeting\"],#meeting-relatedPitchbookIds,#meeting-followUpRequired').forEach(node=>node.addEventListener('change',saveDraft));\nasync function submitMeetingWithFiles(event){\n  event.preventDefault();\n  if(meetingFlowBusy)return;\n  if(readEnvelope('ksp.meeting.outcomeUnknown.v1')){showStatus('meeting-status','error','前回の親登録結果が不明です。重複防止のため停止しました。管理者による保存結果の確認が必要です。');return}\n  clearStatus('meeting-status');\n  const payload=meetingValues(),existingIds=payload.relatedPitchbookIds.slice();\n  if(!kspValidateMeetingRequired('meeting','meeting-status'))return;\n  if(selectedPitchbookFiles.length){const error=validateFiles(selectedPitchbookFiles);if(error){showStatus('meeting-status','error',error);return}}\n  if(pitchbookSlots.length||pitchbookParent){showStatus('meeting-status','warning','保存済み記録の未完了操作は資料欄から再試行してください。新しい記録は「新しい記録を入力」から開始してください。');return}\n  if(retryContext){payload.retryMeetingId=retryContext.meetingId;payload.retryFingerprint=retryContext.fingerprint}\n  // Relationships use the limited relation-only facade after the parent commit.\n  payload.relatedPitchbookIds=[];\n  meetingFlowBusy=true;showStatus('meeting-status','info busy','記録を保存中…');setMeetingBusy(true);\n  try{\n    writeEnvelope('ksp.meeting.outcomeUnknown.v1',{pending:true});\n    const result=await serverCall('registerMeeting',payload);\n    safeRemove('ksp.meeting.outcomeUnknown.v1');\n    if(!result||!result.ok){if(result&&result.retry){retryContext=result.retry;writeEnvelope(KSP_MEETING_RETRY_KEY,retryContext);el('meeting-retry-note').classList.add('visible')}throw new Error(result&&result.error?result.error.message:'記録を保存できませんでした。')}\n    const meeting=result.meeting||{};\n    bindPitchbookParent({meetingId:meeting.id,version:meeting.version,status:meeting.status},false);\n    clearRetryContext();\n    showStatus('meeting-status','success','記録を保存しました: '+meeting.id+'。資料処理を開始します。');\n    pendingExistingDocumentIds=existingIds;savePitchbookSlots();\n    setRegisteredMeetingLocked(true);\n    const attachmentsComplete=await completeParentAttachments();\n    if(attachmentsComplete){clearMeetingSpecificDraft();pitchbookParent=null;savePitchbookSlots();setRegisteredMeetingLocked(false);el('pitchbook-submit').hidden=true;selectedPitchbookFiles=[];fileInput.value='';renderPitchbookFiles();showStatus('meeting-status','success','記録を保存しました: '+meeting.id)}\n  }catch(error){saveMeetingDraft();showStatus('meeting-status','error',(error.message||String(error))+' 入力と保存済みIDは保持されています。')}\n  finally{meetingFlowBusy=false;setMeetingBusy(false);if(pitchbookParent){if(document.activeElement===el('meeting-submit'))el('meeting-status').focus({preventScroll:true});el('meeting-submit').disabled=true}}\n}\nel('meeting-form').addEventListener('submit',submitMeetingWithFiles);\nel('meeting-clear').onclick=()=>clearAllSourceDrafts();\n</script>\n<?!= include_('ClientPitchbookFiles'); ?>\n<?!= include_('ClientPitchbookFlow'); ?>\n<?!= include_('ClientMaintenance'); ?>\n<?!= include_('ClientMaintenanceEnhancements'); ?>\n<?!= include_('ClientSourceRecords'); ?>\n<?!= include_('ClientActivityAnalytics'); ?>\n<?!= include_('ClientRelationshipExplorer'); ?>\n<?!= include_('ClientBootstrap'); ?>\n</body>\n</html>\n",
