  "RelationshipExplorerPage": "<section id=\"page-relationship-explorer\" class=\"page\">\n  <div class=\"card\">\n    <div class=\"section-heading\">\n      <div><h2>資料の関連付け</h2><p class=\"hint\">面談記録と保存資料の関連付けを両方向から確認できます。変更は面談記録の編集画面で行います。</p></div>\n    </div>\n    <div class=\"filter-grid relationship-filters\">\n      <div class=\"field\"><label for=\"relationship-date-from\">開始日</label><input id=\"relationship-date-from\" type=\"date\"></div>\n      <div class=\"field\"><label for=\"relationship-date-to\">終了日</label><input id=\"relationship-date-to\" type=\"date\"></div>\n      <div class=\"field\"><label for=\"relationship-counterparty-type\">面談先種別</label><select id=\"relationship-counterparty-type\"><option value=\"\">未選択</option></select></div>\n      <div class=\"field\"><label for=\"relationship-counterparty-entity\">面談先</label><select id=\"relationship-counterparty-entity\"><option value=\"\">未選択</option></select></div>\n      <div class=\"field\"><label for=\"relationship-asset-class\">アセットクラス</label><select id=\"relationship-asset-class\"><option value=\"\">未選択</option></select></div>\n      <div class=\"field\"><label for=\"relationship-fund-strategy\">Fund / Strategy</label><select id=\"relationship-fund-strategy\"><option value=\"\">未選択</option></select></div>\n      <div class=\"field\"><label for=\"relationship-meeting-status\">面談記録のStatus</label><select id=\"relationship-meeting-status\"><option value=\"\">未選択</option></select></div>\n      <div class=\"field\"><label for=\"relationship-pitchbook-status\">保存資料のStatus</label><select id=\"relationship-pitchbook-status\"><option value=\"\">未選択</option></select></div>\n    </div>\n    <div class=\"actions\"><span class=\"hint\">件数は上限適用前に計算し、表示省略数を明示します。</span><div class=\"action-group\"><button id=\"relationship-explorer-clear\" class=\"action secondary\" type=\"button\">条件をクリア</button><button id=\"relationship-explorer-refresh\" class=\"action primary\" type=\"button\">読み込む</button></div></div>\n  