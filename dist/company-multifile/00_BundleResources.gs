ue,hsv.saturation,hsv.value);\n  const input=themeSettingsElement('theme-color-hex');input.value=themeColorToolState.currentHex;input.setAttribute('aria-invalid','false');themeSettingsElement('theme-color-hex-error').hidden=true;\n  themeColorToolRender();clearStatus('theme-color-tool-status');\n}\nfunction themeColorToolSetFromPoint(event){\n  const rect=themeSettingsElement('theme-color-sv').getBoundingClientRect();\n  themeColorToolSetHsv({...themeColorToolState.hsv,saturation:Math.max(0,Math.min(1,(event.clientX-rect.left)/rect.width)),value:1-Math.max(0,Math.min(1,(event.clientY-rect.top)/rect.height))});\n}\nfunction themeColorToolInit(){\n  const target=themeSettingsElement('theme-color-target');\n  themeSettingsState.definitions.forEach(definition=>{const option=document.createElement('option');option.value=definition.key;option.textContent=definition.label;target.appendChild(option)});\n  themeColorToolState={activeKey:themeSettingsState.definitions[0].key,currentHex:'',hsv:null};themeColorToolSelectKey(themeColorToolState.activeKey);\n  target.addEventListener('change',()=>themeColorToolSelectKey(target.value));\n  const field=themeSettingsElement('theme-color-sv');\n  field.addEventListener('pointerdown',event=>{if(themeSettingsBusy)return;field.setPointerCapture(event.pointerId);themeColorToolSetFromPoint(event)});\n  field.addEventListener('pointermove',event=>{if(!themeSettingsBusy&&field.hasPointerCapture(event.pointerId))themeColorToolSetFromPoint(event)});\n  field.addEventListener('keydown',event=>{\n    if(themeSettingsBusy)return;\n    const delta=event.shiftKey?0.1:0.01,hsv={...themeColorToolState.hsv};\n    if(event.key==='ArrowLeft')hsv.saturation=Math.max(0,hsv.saturation-delta);\n    else if(event.key==='ArrowRight')hsv.saturation=Math.min(1,hsv.saturation+delta);\n    else if(event.key==='ArrowUp')hsv.value=Math.min(1,hsv.value+delta);\n    else if(event.key==='ArrowDown')hsv.value=Math.max(0,hsv.value-delta);\n    else return;\n    event.p