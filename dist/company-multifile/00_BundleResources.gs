rol.value||'').trim())return;kspSetMeetingRequiredError(control,false);const statusId=prefix==='meeting'?'meeting-status':'meeting-edit-status';if(!kspMeetingRequiredControls(prefix).some(item=>item.getAttribute('aria-invalid')==='true')&&el(statusId).textContent==='必須項目を入力してください。')clearStatus(statusId)};control.addEventListener('input',clearWhenValid);control.addEventListener('change',clearWhenValid)}));\nconst kspActionBusyStates=new WeakMap();\nfunction kspActionKeepsFocus(button){const state=button&&kspActionBusyStates.get(button);return Boolean(state&&state.keepFocusable)}\nfunction kspSetActionBusy(button,busy,label){\n  if(!button)return;\n  const current=kspActionBusyStates.get(button);\n  if(busy){\n    if(current){current.label.textContent=String(label||'処理中…');if(current.fallback)button.textContent=current.label.textContent;return}\n    const width=typeof button.getBoundingClientRect==='function'?button.getBoundingClientRect().width:0;\n    const state={nodes:Array.from(button.childNodes||[]),disabled:Boolean(button.disabled),minWidth:button.style?button.style.minWidth:'',fallback:typeof button.replaceChildren!=='function',textContent:button.textContent,keepFocusable:button.classList.contains('ksp-keep-focus-busy')&&document.activeElement===button};\n    const indicator=document.createElement('span'),text=document.createElement('span');\n    indicator.className='ksp-action-busy-content';text.className='ksp-action-busy-label';text.textContent=String(label||'処理中…');indicator.appendChild(text);\n    state.label=text;kspActionBusyStates.set(button,state);if(state.fallback)button.textContent=text.textContent;else button.replaceChildren(indicator);button.classList.add('ksp-action-busy');button.setAttribute('aria-busy','true');button.disabled=!state.keepFocusable;if(state.keepFocusable)button.setAttribute('aria-disabled','true');\n    if(width>0&&button.style)button.style.minWidth=Math.ceil(width)+'px';\n    return;\n  }\n  if(!current){button.classList.remove('ksp-action-busy');button.setAttribute('aria-busy','false');return}\n  if(current.fallback)button.textContent=current.textContent;else button.replaceChildren(...current.nodes);button.classList.remove('ksp-action-busy');button.setAttribute('aria-busy','false');if(current.keepFocusable)button.removeAttribute('aria-disabled');button.disabled=current.disabled;if(button.style)button.style.minWidth=current.minWidth;kspActionBusyStates.delete(button);\n}\nfunction kspSetRegionBusy(region,busy){if(region)region.setAttribute('aria-busy',String(Boolean(busy)))}\nfunction safeGet(key){try{return localStorage.getItem(key)}catch(e){return null}}function safeSet(key,value){try{localStorage.setItem(key,value)}catch(e){}}function safeRemove(key){try{localStorage.removeItem(key)}catch(e){}}\nfunction readEnvelope(key){const raw=safeGet(key);if(!raw)return null;try{const env=JSON.parse(raw);if(!env||typeof env.savedAt!=='number'||Date.now()-env.savedAt>KSP_DRAFT_TTL_MS){safeRemove(key);return null}return env.data||null}catch(e){safeRemove(key);return null}}\nfunction writeEnvelope(key,data){safeSet(key,JSON.stringify({savedAt:Date.now(),data}))}\nfunction sharedId(page,field){return page+'-'+field}function getShared(page){const out={};SHARED_FIELDS.forEach(field=>{const node=el(sharedId(page,field));if(node)out[field]=node.value});return out}\nfunction applyShared(values){if(!values)return;['meeting','pitchbook','news','assessment'].forEach(page=>SHARED_FIELDS.forEach(field=>{const node=el(sharedId(page,field));if(node&&values[field]!=null)node.value=String(values[field])}))}\nfunction syncShared(sourcePage){const values=getShared(sourcePage);applyShared(values)}\nfunction addOptions(id,options){const select=el(id);if(!select)return;const current=select.value;select.innerHTML='<option value=\"\">未選択</option>';(options||[]).forEach(option=>{const node=document.createElement('option');node.value=option.id;node.textContent=option.name+(option.status==='Inactive'?'（Inactive）':'');select.appendChild(node)});if([...select.options].some(option=>option.value===current))select.value=current}\nfunction populateSharedOptions(options){['meeting','pitchbook','news','assessment'].forEach(page=>{addOptions(page+'-assetClassId',options.assetClasses);addOptions(page+'-capitalTypeId',options.capitalTypes)});if(Array.isArray(options.locations))addOptions('meeting-locationId',options.locations);if(Array.isArray(options.teams))addOptions('meeting-teamId',options.teams);if(Array.isArray(options.counterpartyEntities)){meetingCounterpartyEntities=options.counterpartyEntities;refreshMeetingCounterpartyEntities();addOptions('pitchbook-counterpartyId',options.counterpartyEntities)}if(Array.isArray(options.relatedPitchbooks)){meetingRelatedPitchbookCatalog=options.relatedPitchbooks;refreshMeetingRelatedPitchbooks()}}\nfunction refreshMeetingCounterpartyEntities(preferred){const node=el('meeting-counterpartyId');if(!node)return;const selected=preferred===undefined?node.value:String(preferred||'');node.innerHTML='<option value=\"\">未選択</option>';meetingCounterpartyEntities.forEach(item=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.name+'（'+(item.typeLabel||item.type)+'）'+(item.status==='Inactive'?'（Inactive）':'');node.appendChild(option)});if([...node.options].some(option=>option.value===selected))node.value=selected}\nfunction selectedOptionValues(id){const node=el(id);return node?[...node.options].filter(option=>option.selected).map(option=>option.value).filter(Boolean):[]}\nfunction setSelectedOptionValues(id,values){const selected=new Set((values||[]).map(String));const node=el(id);if(node)[...node.options].forEach(option=>option.selected=selected.has(option.value))}\nfunction meetingTypeValues(prefix){return[...document.querySelectorAll('[data-meeting-type=\"'+prefix+'\"]:checked')].map(node=>node.value)}\nfunction setMeetingTypeValues(prefix,values){const selected=new Set((values||[]).map(String));document.querySelectorAll('[data-meeting-type=\"'+prefix+'\"]').forEach(node=>node.checked=selected.has(node.value))}\nfunction refreshMeetingRelatedPitchbooks(previousSelection){const node=el('meeting-relatedPitchbookIds');if(!node)return;const selected=new Set((previousSelection||selectedOptionValues('meeting-relatedPitchbookIds')).map(String));const counterpartyId=el('meeting-counterpartyId').value,asset=el('meeting-assetClassId').value;const choices=meetingRelatedPitchbookCatalog.filter(item=>selected.has(item.id)||(item.status==='Active'&&item.counterpartyId===counterpartyId&&item.assetClassId===asset));node.innerHTML='';choices.forEach(item=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.date+' / '+item.id+' / '+item.title;option.selected=selected.has(item.id);node.appendChild(option)})}\nSHARED_FIELDS.forEach(field=>['meeting','pitchbook','news','assessment'].forEach(page=>{const node=el(sharedId(page,field));if(node){node.addEventListener('input',()=>syncShared(page));node.addEventListener('change',()=>syncShared(page))}}));\nel('meeting-counterpartyId').addEventListener('change',()=>{el('pitchbook-counterpartyId').value=el('meeting-counterpartyId').value;refreshMeetingRelatedPitchbooks([])});\nel('meeting-assetClassId').addEventListener('change',()=>refreshMeetingRelatedPitchbooks([]));\nfunction serverCall(name,payload){return new Promise((resolve,reject)=>{let runner=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);runner[name](payload)})}\n\n</script>\n",
  "ClientDateControls": "<script>\nfunction kspTokyoDateParts(now){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(now||new Date());return Object.fromEntries(parts.map(part=>[part.type,part.value]))}\nfunction kspDefaultDateRange(now){const today=kspTokyoDateParts(now),year=Number(today.year)-3,isLeap=year%4===0&&(year%100!==0||year%400===0),day=today.month==='02'&&today.day==='29'&&!isLeap?'28':today.day;return{from:year+'-'+today.month+'-'+day,to:today.year+'-'+today.month+'-'+today.day}}\nfunction kspSetDefaultDateRange(fromId,toId,now){const from=document.getElementById(fromId),to=document.getElementById(toId),range=kspDefaultDateRange(now);if(from)from.value=range.from;if(to)to.value=range.to;return range}\nfunction kspOneYearDateRange(now){const today=kspTokyoDateParts(now),year=Number(today.year)-1,isLeap=year%4===0&&(year%100!==0||year%400===0),day=today.month==='02'&&today.day==='29'&&!isLeap?'28':today.day;return{from:year+'-'+today.month+'-'+day,to:today.year+'-'+today.month+'-'+today.day}}\nfunction kspSetOneYearDateRange(fromId,toId,now){const from=document.getElementById(fromId),to=document.getElementById(toId),range=kspOneYearDateRange(now);if(from&&!from.value)from.value=range.from;if(to&&!to.value)to.value=range.to;return range}\nfunction kspTryShowDatePicker(event){const input=event&&event.currentTarget;if(!input||input.disabled||input.readOnly||typeof input.showPicker!=='function')return;const last=Number(input.dataset.kspPickerOpenedAt||0);if(last&&Date.now()-last<250)return;try{input.showPicker();input.dataset.kspPickerOpenedAt=String(Date.now())}catch(error){}}\nfunction kspInstallNativeDatePickers(root){(root||document).querySelectorAll('input[type=\"date\"]').forEach(input=>{if(input.dataset.kspPickerReady==='true')return;input.dataset.kspPickerReady='true';input.addEventListener('focus',kspTryShowDatePicker);input.addEventListener('click',kspTryShowDatePicker)})}\n</script>\n",
  "ClientEntityWorkspace": "<script>\nconst KSP_ENTITY_WORKSPACE_PRINT_LIMITS={funds:8,meetings:6,pitchbooks:6,relationships:6,timeline:10};\nlet entityWorkspaceData=null,entityWorkspaceCatalog=null,entityWorkspaceRequestSequence=0,entityWorkspaceCatalogLoaded=false;\nfunction entityWorkspaceText(value){const text=String(value==null?'':value).trim();return text||'—'}\nfunction entityWorkspaceStatusClass(status){return status==='Active'?'Active':status==='Inactive'?'Inactive':status==='Pending'?'Pending':status==='Failed'?'Failed':''}\nfunction entityWorkspaceBadge(status){return '<span class=\"badge '+entityWorkspaceStatusClass(status)+'\">'+kspEscapeHtml(entityWorkspaceText(status))+'</span>'}\nfunction entityWorkspaceScopeLabel(item){const value=String(item.activityScope||item.activityScopeLabel||'');return value==='related'||value==='Related'?'関連':'直接'}\nfunction entityWorkspaceMore(count){return Number(count||0)>0?'<div class=\"gp-more\">ほか'+kspEscapeHtml(count)+'件</div>':''}\nfunction entityWorkspaceLink(url,label){const safe=kspSafeDriveUrl(url);return safe?'<a class=\"small-link\" href=\"'+kspEscapeHtml(safe)+'\" target=\"_blank\" rel=\"noopener\">'+kspEscapeHtml(label)+'</a>':'—'}\n\nfunction entityWorkspacePopulateEntities(preferred){\n  const node=el('entity-workspace-entity'),selected=preferred===undefined?node.value:String(preferred||'');\n  node.innerHTML='<option value=\"\">未選択</option>';\n  ((entityWorkspaceCatalog&&entityWorkspaceCatalog.entityOptions)||[]).forEach(item=>{const option=document.createElement('option');option.value=item.entityKey;option.textContent=item.name+(item.status==='Inactive'?'（削除済み）':'');node.appendChild(option)});\n  if([...node.options].some(option=>option.value===selected))node.value=selected;\n}\nfunction entityWorkspacePopulateFundStrategies(items){\n  const node=el('entity-workspace-fund'),current=node.value;\n  node.innerHTML='<option value=\"\">未選択</option>';\n  ((items&&items.records)||[]).forEach(item=>{const option=document.createElement('option');option.value=item.text;option.textContent=item.text+' (面談 '+item.meetingCount+' / 資料 '+item.pitchbookCount+')';node.appendChild(option)});\n  if([...node.options].some(option=>option.value===current))node.value=current;\n}\nfunction entityWorkspaceMeetingCompact(item){\n  return '<div class=\"entity-list-row\"><strong>'+kspEscapeHtml(item.date||'未設定')+' / '+kspEscapeHtml(item.meetingId)+'</strong><span>'+kspEscapeHtml(entityWorkspaceScopeLabel(item))+' / '+kspEscapeHtml(item.fundStrategy||'未設定')+'</span><span>'+entityWorkspaceBadge(item.status)+' '+entityWorkspaceLink(item.documentUrl,'原本')+'</span></div>';\n}\nfunction entityWorkspaceOwnedPitchbookRow(item){\n  return '<tr><td>'+kspEscapeHtml(item.date||'未設定')+'</td><td>'+kspEscapeHtml(item.documentId)+'</td><td>'+kspEscapeHtml(item.fundStrategy||'未設定')+'</td><td>'+entityWorkspaceBadge(item.status)+'</td><td>'+entityWorkspaceLink(item.fileUrl,'原本')+'</td></tr>';\n}\nfunction entityWorkspaceLinkedPitchbookRow(item){\n  return '<tr><td>'+kspEscapeHtml(item.date||'未設定')+'</td><td>'+kspEscapeHtml(item.documentId)+'</td><td>'+kspEscapeHtml(item.gpName||'登録情報なし')+'</td><td>'+kspEscapeHtml(item.fundStrategy||'未設定')+'</td><td>'+entityWorkspaceBadge(item.status)+'</td><td>'+entityWorkspaceLink(item.fileUrl,'原本')+'</td></tr>';\n}\nfunction entityWorkspaceRenderFunds(data){\n  const items=data.fundStrategies&&data.fundStrategies.records||[];\n  el('entity-workspace-funds').innerHTML=items.map(item=>'<tr><td><button class=\"small-button entity-fund-button\" type=\"button\" data-entity-fund=\"'+kspEscapeHtml(item.text)+'\">'+kspEscapeHtml(item.text)+'</button></td><td>'+kspEscapeHtml(item.meetingCount)+'</td><td>'+kspEscapeHtml(item.pitchbookCount)+'</td><td>'+kspEscapeHtml(item.directMeetingCount)+' / '+kspEscapeHtml(item.relatedMeetingCount)+'</td><td>'+kspEscapeHtml(item.latestDate||'未設定')+'</td><td>'+kspEscapeHtml(item.relationshipCount)+'</td></tr>').join('')||'<tr><td colspan=\"6\" class=\"empty-cell\">該当なし</td></tr>';\n  el('entity-workspace-funds-more').innerHTML=entityWorkspaceMore(data.fundStrategies&&data.fundStrategies.omittedCount);\n  entityWorkspacePopulateFundStrategies(data.fundStrategies);\n}\nfunction entityWorkspaceRenderDrill(drill){\n  const host=el('entity-workspace-drill');\n  if(!drill){host.innerHTML='';return}\n  const meetings=drill.meetings&&drill.meetings.records||[],pitchbooks=drill.pitchbooks&&drill.pitchbooks.records||[],relationships=drill.relationships&&drill.relationships.records||[];\n  host.innerHTML='<h4>詳細: '+kspEscapeHtml(drill.selected)+'</h4><p class=\"hint\">面談記録 '+kspEscapeHtml(drill.counts.meetings)+'件 / 保存資料 '+kspEscapeHtml(drill.counts.pitchbooks)+'件 / 関連付け '+kspEscapeHtml(drill.counts.relationships)+'件</p><div class=\"entity-workspace-grid\"><div><strong>面談記録</strong>'+((meetings.map(entityWorkspaceMeetingCompact).join(''))||'<div class=\"empty-cell\">該当なし</div>')+'</div><div><strong>保存資料</strong>'+((pitchbooks.map(item=>'<div class=\"entity-list-row\"><strong>'+kspEscapeHtml(item.date||'未設定')+' / '+kspEscapeHtml(item.documentId)+'</strong><span>'+kspEscapeHtml(item.fundStrategy||'未設定')+' '+entityWorkspaceBadge(item.status)+'</span><span>'+entityWorkspaceLink(item.fileUrl,'原本')+'</span></div>').join(''))||'<div class=\"empty-cell\">該当なし</div>')+'</div></div><div class=\"entity-relationship-list\">'+((relationships.map(entityWorkspaceRelationship).join(''))||'<div class=\"empty-cell\">該当なし</div>')+'</div>';\n}\nfunction entityWorkspaceRenderMeetings(data){\n  const meetings=data.meetings&&data.meetings.all||{records:[],omittedCount:0};\n  el('entity-workspace-meetings').innerHTML=(meetings.records||[]).map(item=>'<tr><td>'+kspEscapeHtml(item.date||'未設定')+'</td><td>'+kspEscapeHtml(entityWorkspaceScopeLabel(item))+'</td><td>'+kspEscapeHtml(item.counterpartyTypeLabel||'未設定')+'<br>'+kspEscapeHtml(item.counterpartyEntityName||'登録情報なし')+'</td><td>'+kspEscapeHtml(item.teamName||'未設定')+'<br>'+kspEscapeHtml(item.fundStrategy||'未設定')+'</td><td>'+entityWorkspaceBadge(item.status)+'</td><td>'+entityWorkspaceLink(item.documentUrl,'原本')+'</td></tr>').join('')||'<tr><td colspan=\"6\" class=\"empty-cell\">該当なし</td></tr>';\n  el('entity-workspace-meetings-more').innerHTML=entityWorkspaceMore(meetings.omittedCount);\n}\nfunction entityWorkspaceRenderMixes(mixes){\n  const groups=[['チーム',mixes.teams],['アセットクラス',mixes.assetClasses],['MTG種別',mixes.meetingTypes]];\n  el('entity-workspace-mixes').innerHTML=groups.map(group=>'<div class=\"entity-mix-group\"><strong>'+group[0]+'</strong><span>'+((group[1]||[]).map(item=>kspEscapeHtml(item.label)+' '+kspEscapeHtml(item.count)).join(' / ')||'未設定')+'</span></div>').join('');\n}\nfunction entityWorkspaceRelationship(item){\n  const targets=(item.pitchbooks||[]).map(target=>target.unresolved?'<span class=\"badge Failed\">未解決: '+kspEscapeHtml(target.documentId)+'</span>':'<span>'+kspEscapeHtml(target.documentId)+' / '+kspEscapeHtml(entityWorkspaceText(target.savedFilename))+' '+entityWorkspaceBadge(target.status)+' '+entityWorkspaceLink(target.fileUrl,'原本')+'</span>').join('<br>')||'未設定';\n  return '<div class=\"entity-relationship-row\"><div><strong>'+kspEscapeHtml(item.date||'未設定')+' / '+kspEscapeHtml(item.meetingId)+'</strong><span>'+kspEscapeHtml(item.fundStrategy||'未設定')+'</span></div><div>'+targets+'</div></div>';\n}\nfunction entityWorkspaceRenderRelationships(data){\n  const items=data.relationships||[];\n  el('entity-workspace-relationships').innerHTML=items.map(entityWorkspaceRelationship).join('')||'<div class=\"empty-cell\">関連付けられた資料はありません。</div>';\n}\nfunction entityWorkspaceRenderTimeline(data){\n  const timeline=data.timeline&&data.timeline.records||[];\n  el('entity-workspace-timeline').innerHTML=timeline.map(item=>'<div class=\"entity-timeline-row\"><strong>'+kspEscapeHtml(item.date||'未設定')+'</strong><span>'+kspEscapeHtml(item.kind)+' / '+kspEscapeHtml(item.id)+'</span><span>'+entityWorkspaceBadge(item.status)+' '+(item.sourceUrl?entityWorkspaceLink(item.sourceUrl,'原本'):'')+'</span></div>').join('')||'<div class=\"empty-cell\">該当なし</div>';\n}\nfunction entityWorkspaceRenderPrint(data){\n  const limit=(items,key)=>({items:(items||[]).slice(0,KSP_ENTITY_WORKSPACE_PRINT_LIMITS[key]),more:Math.max(0,(items||[]).length-KSP_ENTITY_WORKSPACE_PRINT_LIMITS[key])});\n  const funds=limit(data.fundStrategies&&data.fundStrategies.records,'funds'),meetings=limit(data.meetings&&data.meetings.all&&data.meetings.all.records,'meetings'),pitchbooks=limit(data.pitchbooks&&data.pitchbooks.records,'pitchbooks'),relationships=limit(data.relationships,'relationships'),timeline=limit(data.timeline&&data.timeline.records,'timeline');\n  const section=(title,items,renderer,more,omitted)=>'<section class=\"gp-print-section\"><h3>'+kspEscapeHtml(title)+'</h3>'+items.map(renderer).join('')+entityWorkspaceMore(Number(more||0)+Number(omitted||0))+'</section>';\n  const omitted=data.omittedCounts||{};\n  el('entity-workspace-print').innerHTML='<header class=\"gp-print-header\"><div><h1>'+kspEscapeHtml(data.entity.name)+'</h1><span>'+kspEscapeHtml(data.entity.status)+'</span></div><div class=\"gp-print-summary\"><span>面談件数 <b>'+kspEscapeHtml(data.summary.activeMeetingCount)+'件</b></span><span>保存資料数 <b>'+kspEscapeHtml(data.summary.pitchbookActiveCount)+'件</b></span><span>最後の面談日 <b>'+kspEscapeHtml(data.summary.latestDirectMeetingDate||'未設定')+'</b></span></div></header>'+section('Fund / Strategy',funds.items,item=>'<div class=\"gp-print-row\"><b>'+kspEscapeHtml(item.text)+'</b><span>面談 '+kspEscapeHtml(item.meetingCount)+' / 資料 '+kspEscapeHtml(item.pitchbookCount)+'</span></div>',funds.more,omitted.fundStrategies)+section('面談記録',meetings.items,item=>'<div class=\"gp-print-row\"><b>'+kspEscapeHtml(item.date)+' / '+kspEscapeHtml(item.meetingId)+'</b><span>'+kspEscapeHtml(entityWorkspaceScopeLabel(item))+' / '+kspEscapeHtml(item.fundStrategy||'未設定')+'</span></div>',meetings.more,omitted.directMeetings+omitted.relatedMeetings)+section('保存資料',pitchbooks.items,item=>'<div class=\"gp-print-row\"><b>'+kspEscapeHtml(item.date)+' / '+kspEscapeHtml(item.documentId)+'</b><span>'+kspEscapeHtml(item.fundStrategy||'未設定')+'</span></div>',pitchbooks.more,omitted.pitchbooks)+section('関連資料',relationships.items,item=>'<div class=\"gp-print-row\"><b>'+kspEscapeHtml(item.date)+' / '+kspEscapeHtml(item.meetingId)+'</b><span>'+kspEscapeHtml((item.pitchbooks||[]).map(target=>target.documentId).join(', ')||'未設定')+'</span></div>',relationships.more,omitted.relationships)+section('活動履歴',timeline.items,item=>'<div class=\"gp-print-row\"><b>'+kspEscapeHtml(item.date)+' / '+kspEscapeHtml(item.kind)+'</b><span>'+kspEscapeHtml(item.id)+'</span></div>',timeline.more,omitted.timeline);\n}\nfunction entityWorkspaceRender(data){\n  entityWorkspaceData=data;\n  const entity=data.entity;\n  el('entity-workspace-name').textContent=entity.name;\n  el('entity-workspace-identity').textContent='';\n  el('entity-workspace-entity-status').className='badge '+entityWorkspaceStatusClass(entity.status);\n  el('entity-workspace-entity-status').textContent=entityWorkspaceText(entity.status);\n  const s=data.summary;\n  el('entity-workspace-summary').innerHTML=[['面談件数',s.activeMeetingCount+'件'],['保存資料数',s.pitchbookActiveCount+'件'],['最後の面談日',entityWorkspaceText(s.latestDirectMeetingDate)]].map(item=>'<div class=\"card entity-summary-card\"><span>'+kspEscapeHtml(item[0])+'</span><strong>'+kspEscapeHtml(item[1])+'</strong></div>').join('');\n  entityWorkspaceRenderFunds(data);entityWorkspaceRenderMeetings(data);entityWorkspaceRenderMixes(data.mixes||{});entityWorkspaceRenderRelationships(data);entityWorkspaceRenderTimeline(data);entityWorkspaceRenderDrill(data.drillDown);\n  const direct=data.meetings.direct.records||[];\n  el('entity-workspace-gp-direct-meetings').innerHTML=direct.map(entityWorkspaceMeetingCompact).join('')||'<div class=\"empty-cell\">該当なし</div>';\n  el('entity-workspace-owned-pitchbooks').innerHTML=(data.pitchbooks.records||[]).map(entityWorkspaceOwnedPitchbookRow).join('')||'<tr><td colspan=\"5\" class=\"empty-cell\">該当なし</td></tr>';\n  entityWorkspaceRenderPrint(data);el('entity-workspace-content').classList.remove('hidden-panel');el('entity-workspace-print-button').disabled=false;\n}\nasync function loadEntityWorkspaceCatalog(){\n  if(entityWorkspaceCatalogLoaded)return;\n  const requestId=++entityWorkspaceRequestSequence;showStatus('entity-workspace-status','info','面談先一覧を読み込んでいます。');\n  try{const result=await serverCall('getEntityWorkspaceData',{});if(requestId!==entityWorkspaceRequestSequence)return;if(!result||!result.ok)throw new Error(result&&result.error?result.error.message:'面談先一覧を読み込めませんでした。');entityWorkspaceCatalog=result;entityWorkspaceCatalogLoaded=true;entityWorkspacePopulateEntities();showStatus('entity-workspace-status','info','面談先を選択してください。')}catch(error){if(requestId===entityWorkspaceRequestSequence)showStatus('entity-workspace-status','error',error.message||String(error))}\n}\nasync function loadEntityWorkspace(){\n  const selected=el('entity-workspace-entity'),entityKey=selected.value,requestId=++entityWorkspaceRequestSequence;\n  entityWorkspaceData=null;el('entity-workspace-content').classList.add('hidden-panel');el('entity-workspace-print-button').disabled=true;el('entity-workspace-fund').value='';\n  if(!entityKey){showStatus('entity-workspace-status','info','面談先を選択してください。');return}\n  const label=selected.selectedOptions&&selected.selectedOptions.length?selected.selectedOptions[0].textContent.trim():entityKey;\n  showStatus('entity-workspace-status','info busy','面談先「'+label+'」を読み込んでいます…');\n  try{const result=await serverCall('getEntityWorkspaceData',{entityKey:entityKey});if(requestId!==entityWorkspaceRequestSequence||selected.value!==entityKey)return;if(!result||!result.ok)throw new Error(result&&result.error?result.error.message:'面談先サマリーを読み込めませんでした。');if(!result.entity||result.entity.entityKey!==entityKey)throw new Error('選択した面談先の結果を確認できませんでした。');entityWorkspac